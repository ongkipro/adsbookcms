---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AUTOLARIS_CHANNELS } from '../../lib/autolaris-client';
import { paymentFeeDescription } from '../../lib/payment-fee-policy';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import SellerBankAccounts from '../../components/admin/SellerBankAccounts';

export const prerender = false;

const channelLabels: Record<(typeof AUTOLARIS_CHANNELS)[number], string> = {
  QRIS: 'QRIS (BCA, Mandiri, GoPay, OVO, ShopeePay, Dana, LinkAja)',
  VABCA: 'Virtual Account BCA',
  VAMANDIRI: 'Virtual Account Mandiri',
  VABNI: 'Virtual Account BNI',
  VABRI: 'Virtual Account BRI',
  VAPERMATA: 'Virtual Account Permata',
  VABSI: 'Virtual Account BSI',
  VACIMB: 'Virtual Account CIMB Niaga',
  VADANAMON: 'Virtual Account Danamon',
  DANA: 'DANA E-Wallet',
};
const callbackUrl = new URL('/api/webhooks/autolaris', Astro.url.origin).toString();
---

<AdminLayout title="Metode Pembayaran & Payment Gateway" activeMenu="payments">
  <div class="max-w-6xl space-y-6">
    <AdminPageHeader
      eyebrow="Payments & Gateways"
      title="Metode Pembayaran & Kredensial"
      description="Kelola metode pembayaran aktif, kredensial AutoLaris, penanggung biaya transaksi, dan rekening bank. Metode berstatus Aktif otomatis tampil di checkout; metode Nonaktif atau Belum Dikonfigurasi otomatis disembunyikan."
    >
      <a slot="actions" href="/admin/balance" class="btn-secondary min-h-11 px-4 text-xs font-bold">Buka rekonsiliasi</a>
    </AdminPageHeader>

    <!-- Master Payment Toggles Section -->
    <section class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-xs md:p-6">
      <div class="border-b border-slate-100 pb-4">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-sm font-bold text-slate-900">1. Status Aktif Metode Pembayaran di Checkout</h3>
          <span id="paymentMasterSummaryBadge" class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-1 text-[11px] font-bold text-blue-700 border border-blue-200/80">
            <span class="size-1.5 rounded-full bg-blue-600 animate-pulse"></span>
            Memuat status…
          </span>
        </div>
        <p class="mt-1 text-xs leading-5 text-slate-600">
          Metode yang diaktifkan di sini akan otomatis muncul sebagai opsi pembayaran di form checkout pembeli. Jika dinonaktifkan, opsi tersebut disembunyikan secara otomatis dari halaman toko.
        </p>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <!-- COD Toggle Card -->
        <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition-all hover:bg-slate-50" data-payment-master-card="cod">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span id="codStatusBadge" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-slate-100 text-slate-600 border-slate-200">
                <span class="size-1.5 rounded-full bg-slate-400"></span>
                Memeriksa…
              </span>
              <h4 class="text-sm font-bold text-slate-950">COD (Bayar di Tempat)</h4>
            </div>
            <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 shadow-2xs">
              <span class="sr-only">Aktifkan pembayaran COD di checkout</span>
              <input id="codToggle" type="checkbox" class="peer sr-only" />
              <span class="relative h-6 w-11 rounded-full bg-slate-300 transition-colors after:absolute after:left-1 after:top-1 after:size-4 after:rounded-full after:bg-white after:shadow-xs after:transition-transform peer-checked:bg-emerald-600 peer-checked:after:translate-x-5 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-emerald-600"></span>
            </label>
          </div>
          <p class="mt-2.5 text-xs leading-5 text-slate-600">
            Pembeli membayar secara tunai saat barang tiba melalui kurir ekspedisi.
          </p>
          <div class="mt-3 flex items-center justify-between border-t border-slate-200/80 pt-2.5 text-[11px] text-slate-500">
            <span>Penanggung fee: <strong id="codFeeBearerLabel" class="text-slate-700">Pembeli</strong></span>
            <span>Biaya: 3% + PPN</span>
          </div>
        </article>

        <!-- AutoLaris PG Toggle Card -->
        <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition-all hover:bg-slate-50" data-payment-master-card="autolaris">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span id="autolarisToggleBadge" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-slate-100 text-slate-600 border-slate-200">
                <span class="size-1.5 rounded-full bg-slate-400"></span>
                Memeriksa…
              </span>
              <h4 class="text-sm font-bold text-slate-950">AutoLaris Payment Gateway</h4>
            </div>
            <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 shadow-2xs">
              <span class="sr-only">Aktifkan AutoLaris PG di checkout</span>
              <input id="autolarisToggle" type="checkbox" class="peer sr-only" />
              <span class="relative h-6 w-11 rounded-full bg-slate-300 transition-colors after:absolute after:left-1 after:top-1 after:size-4 after:rounded-full after:bg-white after:shadow-xs after:transition-transform peer-checked:bg-emerald-600 peer-checked:after:translate-x-5 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-emerald-600"></span>
            </label>
          </div>
          <p class="mt-2.5 text-xs leading-5 text-slate-600">
            Otomatisasi pembayaran online via QRIS (semua e-wallet) & 9 Virtual Account Bank.
          </p>
          <div class="mt-3 flex items-center justify-between border-t border-slate-200/80 pt-2.5 text-[11px] text-slate-500">
            <span>Kredensial: <strong id="autolarisCredStatus" class="text-slate-700">Checking…</strong></span>
            <span>Channel: <strong class="text-slate-700">10 Metode</strong></span>
          </div>
        </article>

        <!-- Manual Bank Transfer Summary Card -->
        <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition-all hover:bg-slate-50" data-payment-master-card="manual">
          <div class="flex items-start justify-between gap-3">
            <div class="space-y-1">
              <span id="manualBankBadge" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-slate-100 text-slate-600 border-slate-200">
                <span class="size-1.5 rounded-full bg-slate-400"></span>
                Memeriksa…
              </span>
              <h4 class="text-sm font-bold text-slate-950">Transfer Bank Manual</h4>
            </div>
            <a href="#rekening-bank-section" class="btn-secondary min-h-9 px-3 text-[11px] font-bold">
              Kelola
            </a>
          </div>
          <p class="mt-2.5 text-xs leading-5 text-slate-600">
            Pembeli mentransfer manual ke rekening bank toko. Ditampilkan jika minimal 1 rekening aktif.
          </p>
          <div class="mt-3 flex items-center justify-between border-t border-slate-200/80 pt-2.5 text-[11px] text-slate-500">
            <span>Status Rekening: <strong id="manualBankCountLabel" class="text-slate-700">Checking…</strong></span>
            <span>Fee Admin: <strong class="text-emerald-700">Rp0 (Gratis)</strong></span>
          </div>
        </article>
      </div>

      <div id="paymentMasterNoticeMsg" class="hidden mt-4 rounded-lg border p-3 text-xs font-bold" role="status" aria-live="polite"></div>
    </section>

    <!-- Section 2: AutoLaris Credentials & Webhook -->
    <section class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-xs md:p-6">
      <h3 class="border-b border-slate-100 pb-3 text-sm font-bold text-slate-900">2. Kesiapan API & Callback Webhook AutoLaris</h3>
      <p class="mt-3 text-xs leading-5 text-slate-600">Integrasi siap penuh setelah API key dan callback secret tersimpan. Pemeriksaan di halaman ini membaca konfigurasi lokal untuk memastikan kesiapan transaksi.</p>
      <div class="mt-4 grid grid-cols-1 gap-5 lg:grid-cols-3">
        <div>
          <p class="mb-1.5 text-xs font-bold text-slate-700">AutoLaris API Key</p>
          <div class="admin-input-flat flex items-center justify-between bg-slate-50 font-mono text-xs text-slate-700" aria-live="polite">
            <span id="autolarisTokenMasked">Memuat…</span>
            <span id="autolarisTokenBadge" class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600">Memeriksa</span>
          </div>
          <span class="mt-1.5 block text-[11px] text-slate-500">Digunakan untuk membuat transaksi QRIS & Virtual Account.</span>
        </div>
        <div>
          <p class="mb-1.5 text-xs font-bold text-slate-700">Callback Secret</p>
          <div class="admin-input-flat flex items-center justify-between bg-slate-50 font-mono text-xs text-slate-700" aria-live="polite">
            <span id="autolarisSecretMasked">Memuat…</span>
            <span id="autolarisSecretBadge" class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600">Memeriksa</span>
          </div>
          <span class="mt-1.5 block text-[11px] text-slate-500">Digunakan untuk verifikasi keaslian callback pembayaran.</span>
        </div>
        <label class="block">
          <span class="mb-1.5 block text-xs font-bold text-slate-700">Webhook Callback URL</span>
          <input type="text" value={callbackUrl} readonly class="admin-input-flat cursor-text bg-slate-100 font-mono text-base text-slate-600 md:text-xs" />
          <span class="mt-1.5 block text-[11px] text-slate-500">Tempel URL ini pada dashboard AutoLaris. URL ini bukan credential.</span>
        </label>
      </div>
      <div class="mt-5 flex flex-wrap gap-3 border-t border-slate-100 pt-4">
        <button id="btnTestAutolaris" type="button" class="btn-secondary min-h-11 px-4 text-xs font-bold" disabled>Periksa kesiapan lokal</button>
        <a href="/admin/profile" class="btn-blue min-h-11 px-4 text-xs font-bold">Kelola Kredensial API</a>
      </div>
      <div id="autolarisStatusMsg" class="hidden mt-3 rounded-lg border p-3 text-xs font-bold" role="status" aria-live="polite"></div>
    </section>

    <!-- Section 3: Fee Policy -->
    <section class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-xs md:p-6">
      <div class="border-b border-slate-100 pb-4">
        <h3 class="text-sm font-bold text-slate-900">3. Kebijakan Penanggung Biaya Admin Transaksi</h3>
        <p class="mt-1 max-w-3xl text-xs leading-5 text-slate-600">Tentukan pihak yang memikul biaya admin per metode. Jika diset Pembeli, fee ditambahkan ke total checkout. Jika diset Seller, fee dipotong dari hasil bersih.</p>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4" data-fee-policy-card="online">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Pembayaran Online AutoLaris</p>
              <h4 class="mt-1 text-sm font-bold text-slate-950">Biaya Channel QRIS & Virtual Account</h4>
              <p class="mt-1.5 max-w-md text-[11px] leading-5 text-slate-600">Jika Seller dipilih, fee dipotong dari dana yang diterima. Jika Pembeli dipilih, fee ditambahkan ke total checkout pembeli.</p>
            </div>
            <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2">
              <span class="sr-only">Bebankan biaya pembayaran online kepada pembeli</span>
              <input id="paymentFeeBearerToggle" type="checkbox" class="peer sr-only" />
              <span class="relative h-6 w-11 rounded-full bg-amber-500 transition-colors after:absolute after:left-1 after:top-1 after:size-4 after:rounded-full after:bg-white after:shadow-xs after:transition-transform peer-checked:bg-blue-600 peer-checked:after:translate-x-5 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-blue-600"></span>
            </label>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-2" aria-live="polite">
            <div data-fee-side="seller" class="rounded-lg border px-3 py-2.5">
              <p class="text-xs font-black">Seller</p>
              <p class="mt-1 text-[11px] leading-4">Fee memotong hasil bersih toko.</p>
            </div>
            <div data-fee-side="buyer" class="rounded-lg border px-3 py-2.5">
              <p class="text-xs font-black">Pembeli</p>
              <p class="mt-1 text-[11px] leading-4">Fee ditambahkan ke tagihan customer.</p>
            </div>
          </div>
        </article>

        <article class="rounded-xl border border-slate-200 bg-slate-50/70 p-4" data-fee-policy-card="cod">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500">COD (Bayar di Tempat)</p>
              <h4 class="mt-1 text-sm font-bold text-slate-950">Biaya Layanan COD 3% + PPN 11% dari Fee</h4>
            </div>
            <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2">
              <span class="sr-only">Bebankan biaya COD kepada pembeli</span>
              <input id="codFeeBearerToggle" type="checkbox" class="peer sr-only" />
              <span class="relative h-6 w-11 rounded-full bg-amber-500 transition-colors after:absolute after:left-1 after:top-1 after:size-4 after:rounded-full after:bg-white after:shadow-xs after:transition-transform peer-checked:bg-blue-600 peer-checked:after:translate-x-5 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-blue-600"></span>
            </label>
          </div>
          <p class="mt-3 rounded-lg border border-slate-200 bg-white px-3 py-2 text-[11px] leading-5 text-slate-600">Dasar hitung: harga produk + ongkir. Contoh total Rp100.000 → fee Rp3.000 + PPN Rp330 = Rp3.330.</p>
          <div class="mt-3 grid grid-cols-2 gap-2" aria-live="polite">
            <div data-fee-side="seller" class="rounded-lg border px-3 py-2.5">
              <p class="text-xs font-black">Seller</p>
              <p class="mt-1 text-[11px] leading-4">Pembeli bayar nilai transaksi saja.</p>
            </div>
            <div data-fee-side="buyer" class="rounded-lg border px-3 py-2.5">
              <p class="text-xs font-black">Pembeli</p>
              <p class="mt-1 text-[11px] leading-4">Fee COD + PPN masuk tagihan COD.</p>
            </div>
          </div>
        </article>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button id="btnSaveFeePolicy" type="button" class="btn-blue min-h-11 px-4 text-xs font-bold">Simpan Kebijakan Biaya</button>
        <span id="paymentFeePolicyStatus" class="text-xs font-medium text-slate-600" role="status" aria-live="polite"></span>
      </div>
    </section>

    <!-- Section 4: Seller Bank Accounts -->
    <section id="rekening-bank-section" class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-xs md:p-6 scroll-mt-20">
      <div class="border-b border-slate-100 pb-4">
        <h3 class="text-sm font-bold text-slate-900">4. Rekening Transfer Bank Manual</h3>
        <p class="mt-1 max-w-3xl text-xs leading-5 text-slate-600">Tambahkan rekening penerima untuk transfer manual. Rekening berstatus <strong>Aktif</strong> otomatis tampil di opsi checkout pembeli.</p>
      </div>
      <SellerBankAccounts client:load />
    </section>

    <!-- Section 5: AutoLaris Channel, Active Toggles & Live Health Check -->
    <section class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-xs md:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
        <div>
          <h3 class="text-sm font-bold text-slate-900">5. Daftar Channel, Status Aktif & Tarif AutoLaris</h3>
          <p class="mt-1 max-w-3xl text-[11px] leading-5 text-slate-500">
            Aktifkan/nonaktifkan channel secara individu. Channel yang dinonaktifkan di sini <strong>otomatis disembunyikan dari form checkout pembeli</strong>.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="btnTestChannelHealth"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700 shadow-2xs hover:bg-blue-100 transition-colors"
          >
            <span class="size-2 rounded-full bg-blue-600 animate-pulse"></span>
            Periksa Kesiapan Channel Live
          </button>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-700">{AUTOLARIS_CHANNELS.length} Channel</span>
        </div>
      </div>

      <div id="channelHealthNotice" class="mt-3 rounded-lg border border-blue-100 bg-blue-50/60 p-3 text-xs text-blue-900" hidden>
        <span id="channelHealthNoticeText">Pemeriksaan kesiapan channel AutoLaris selesai.</span>
      </div>

      <div class="mt-4 overflow-x-auto focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" role="region" aria-label="Channel pembayaran yang didukung" tabindex="0">
        <table class="w-full min-w-[620px] border-collapse text-left text-xs">
          <thead>
            <tr class="border-b border-slate-200/80 bg-slate-50 font-bold uppercase tracking-wider text-slate-500">
              <th class="px-4 py-3">Channel Pembayaran</th>
              <th class="px-4 py-3">Kode API</th>
              <th class="px-4 py-3 text-right">Biaya Admin</th>
              <th class="px-4 py-3 text-center">Status ketersediaan</th>
              <th class="px-4 py-3 text-center">Tampil di Checkout</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {AUTOLARIS_CHANNELS.map((channel) => (
              <tr class="transition-colors hover:bg-slate-50/80" data-channel-row={channel}>
                <td class="px-4 py-3.5 font-bold text-slate-900">{channelLabels[channel]}</td>
                <td class="px-4 py-3.5 font-mono font-bold text-blue-700">{channel}</td>
                <td class="px-4 py-3.5 text-right font-medium text-slate-600">{channel === 'DANA' ? 'Tidak aktif' : paymentFeeDescription(channel)}</td>
                <td class="px-4 py-3.5 text-center">
                  <span id={`channel-badge-${channel}`} class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-[10px] font-bold text-slate-600">
                    <span class="size-1.5 rounded-full bg-slate-400"></span>
                    Memuat...
                  </span>
                </td>
                <td class="px-4 py-3.5 text-center">
                  <label class="relative inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center">
                    <input
                      type="checkbox"
                      class="peer sr-only autolaris-channel-toggle"
                      data-channel-code={channel}
                      checked
                    />
                    <div class="peer h-5 w-9 rounded-full bg-slate-200 after:absolute after:top-[2px] after:left-[2px] after:h-4 after:w-4 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-emerald-600 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-hidden"></div>
                  </label>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <script>
    const codToggle = document.getElementById('codToggle') as HTMLInputElement | null;
    const autolarisToggle = document.getElementById('autolarisToggle') as HTMLInputElement | null;
    const codStatusBadge = document.getElementById('codStatusBadge');
    const autolarisToggleBadge = document.getElementById('autolarisToggleBadge');
    const manualBankBadge = document.getElementById('manualBankBadge');
    const summaryBadge = document.getElementById('paymentMasterSummaryBadge');
    const masterNoticeMsg = document.getElementById('paymentMasterNoticeMsg');
    const autolarisCredStatus = document.getElementById('autolarisCredStatus');
    const manualBankCountLabel = document.getElementById('manualBankCountLabel');
    const codFeeBearerLabel = document.getElementById('codFeeBearerLabel');

    const testBtn = document.getElementById('btnTestAutolaris') as HTMLButtonElement | null;
    const msgBox = document.getElementById('autolarisStatusMsg');
    const masked = document.getElementById('autolarisTokenMasked');
    const badge = document.getElementById('autolarisTokenBadge');
    const secretMasked = document.getElementById('autolarisSecretMasked');
    const secretBadge = document.getElementById('autolarisSecretBadge');
    const feeBearerToggle = document.getElementById('paymentFeeBearerToggle') as HTMLInputElement | null;
    const codFeeBearerToggle = document.getElementById('codFeeBearerToggle') as HTMLInputElement | null;
    const saveFeePolicyBtn = document.getElementById('btnSaveFeePolicy') as HTMLButtonElement | null;
    const feePolicyStatus = document.getElementById('paymentFeePolicyStatus');

    let stateStoreSettings = {
      is_cod_enabled: true,
      is_autolaris_enabled: true,
      api_key_ready: false,
    };

    const updateMasterBadges = () => {
      // 1. COD Badge
      if (codStatusBadge && codToggle) {
        const active = codToggle.checked;
        codStatusBadge.innerHTML = active
          ? '<span class="size-1.5 rounded-full bg-emerald-500"></span> ● Aktif (Tampil di Checkout)'
          : '<span class="size-1.5 rounded-full bg-slate-400"></span> ○ Nonaktif (Disembunyikan)';
        codStatusBadge.className = active
          ? 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-emerald-50 text-emerald-800 border-emerald-200'
          : 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-slate-100 text-slate-600 border-slate-200';
      }

      // 2. AutoLaris Badge
      if (autolarisToggleBadge && autolarisToggle) {
        const enabled = autolarisToggle.checked;
        const ready = stateStoreSettings.api_key_ready;
        if (!ready) {
          autolarisToggleBadge.innerHTML = '<span class="size-1.5 rounded-full bg-rose-500"></span> ⚠ Belum Dikonfigurasi';
          autolarisToggleBadge.className = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-rose-50 text-rose-800 border-rose-200';
        } else if (enabled) {
          autolarisToggleBadge.innerHTML = '<span class="size-1.5 rounded-full bg-emerald-500"></span> ● Aktif (Tampil di Checkout)';
          autolarisToggleBadge.className = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-emerald-50 text-emerald-800 border-emerald-200';
        } else {
          autolarisToggleBadge.innerHTML = '<span class="size-1.5 rounded-full bg-slate-400"></span> ○ Nonaktif oleh Toko';
          autolarisToggleBadge.className = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-slate-100 text-slate-600 border-slate-200';
        }
      }

      // 3. Summary Badge
      if (summaryBadge && codToggle && autolarisToggle) {
        const codActive = codToggle.checked;
        const autolarisActive = autolarisToggle.checked && stateStoreSettings.api_key_ready;
        const totalActive = (codActive ? 1 : 0) + (autolarisActive ? 1 : 0);
        summaryBadge.innerHTML = `<span class="size-1.5 rounded-full ${totalActive > 0 ? 'bg-emerald-500' : 'bg-amber-500'}"></span> ${totalActive} Provider Checkout Aktif`;
        summaryBadge.className = `inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold border ${totalActive > 0 ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-amber-50 text-amber-800 border-amber-200'}`;
      }
    };

    const showMasterNotice = (msg: string, isError = false) => {
      if (!masterNoticeMsg) return;
      masterNoticeMsg.textContent = msg;
      masterNoticeMsg.className = `mt-4 rounded-lg border p-3 text-xs font-bold ${isError ? 'border-rose-200 bg-rose-50 text-rose-800' : 'border-emerald-200 bg-emerald-50 text-emerald-800'}`;
      masterNoticeMsg.hidden = false;
      setTimeout(() => {
        if (masterNoticeMsg) masterNoticeMsg.hidden = true;
      }, 5000);
    };

    const saveToggles = async () => {
      if (!codToggle || !autolarisToggle) return;
      codToggle.disabled = true;
      autolarisToggle.disabled = true;
      try {
        const res = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save-payment-toggles',
            is_cod_enabled: codToggle.checked,
            is_autolaris_enabled: autolarisToggle.checked,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false) {
          throw new Error(data.error || 'Gagal menyimpan status metode pembayaran.');
        }
        stateStoreSettings.is_cod_enabled = codToggle.checked;
        stateStoreSettings.is_autolaris_enabled = autolarisToggle.checked;
        updateMasterBadges();
        showMasterNotice(data.message || 'Status metode pembayaran diperbarui.');
      } catch (err) {
        showMasterNotice(err instanceof Error ? err.message : 'Gagal menyimpan status.', true);
        codToggle.checked = stateStoreSettings.is_cod_enabled;
        autolarisToggle.checked = stateStoreSettings.is_autolaris_enabled;
        updateMasterBadges();
      } finally {
        codToggle.disabled = false;
        autolarisToggle.disabled = false;
      }
    };

    codToggle?.addEventListener('change', () => void saveToggles());
    autolarisToggle?.addEventListener('change', () => void saveToggles());

    const syncFeePolicyCard = (kind: 'online' | 'cod', buyerPays: boolean) => {
      const card = document.querySelector<HTMLElement>(`[data-fee-policy-card="${kind}"]`);
      if (!card) return;
      card.querySelectorAll<HTMLElement>('[data-fee-side]').forEach((side) => {
        const active = side.dataset.feeSide === (buyerPays ? 'buyer' : 'seller');
        side.className = active
          ? `rounded-lg border px-3 py-2.5 ${buyerPays ? 'border-blue-300 bg-blue-100 text-blue-950 ring-1 ring-blue-200' : 'border-amber-300 bg-amber-100 text-amber-950 ring-1 ring-amber-200'}`
          : 'rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-slate-500';
      });
      if (kind === 'cod' && codFeeBearerLabel) {
        codFeeBearerLabel.textContent = buyerPays ? 'Pembeli' : 'Seller';
      }
    };
    feeBearerToggle?.addEventListener('change', () => syncFeePolicyCard('online', feeBearerToggle.checked));
    codFeeBearerToggle?.addEventListener('change', () => syncFeePolicyCard('cod', codFeeBearerToggle.checked));

    const showMessage = (message: string, state: 'ready' | 'setup' | 'error') => {
      if (!msgBox) return;
      msgBox.textContent = message;
      msgBox.setAttribute('role', state === 'error' ? 'alert' : 'status');
      msgBox.className = `mt-3 rounded-lg border p-3 text-xs font-bold ${
        state === 'ready'
          ? 'border-emerald-200 bg-emerald-50 text-emerald-800'
          : state === 'setup'
            ? 'border-amber-200 bg-amber-50 text-amber-900'
            : 'border-rose-200 bg-rose-50 text-rose-800'
      }`;
    };

    let disabledChannels: string[] = [];

    const updateChannelBadges = () => {
      const isMasterEnabled = autolarisToggle?.checked ?? true;
      const apiReady = stateStoreSettings.api_key_ready;

      document.querySelectorAll<HTMLInputElement>('.autolaris-channel-toggle').forEach((input) => {
        const code = input.dataset.channelCode;
        if (!code) return;
        const isDisabledByStore = disabledChannels.includes(code);
        input.checked = !isDisabledByStore;

        const badgeEl = document.getElementById(`channel-badge-${code}`);
        if (!badgeEl) return;

        if (!apiReady) {
          badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-rose-500"></span> ⚠ Belum Dikonfigurasi';
          badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-rose-200 bg-rose-50 px-2.5 py-0.5 text-[10px] font-bold text-rose-800';
        } else if (!isMasterEnabled) {
          badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-slate-400"></span> ○ AutoLaris Nonaktif';
          badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-[10px] font-bold text-slate-600';
        } else if (isDisabledByStore) {
          badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-amber-500"></span> ○ Nonaktif (Disembunyikan)';
          badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-[10px] font-bold text-amber-800';
        } else {
          badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-emerald-500"></span> ● Aktif & Tampil di Checkout';
          badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800';
        }
      });
    };

    // Listen to individual channel toggle switches
    document.querySelectorAll<HTMLInputElement>('.autolaris-channel-toggle').forEach((input) => {
      input.addEventListener('change', async () => {
        const disabled: string[] = [];
        document.querySelectorAll<HTMLInputElement>('.autolaris-channel-toggle').forEach((chk) => {
          const code = chk.dataset.channelCode;
          if (code && !chk.checked) disabled.push(code);
        });
        disabledChannels = disabled;
        updateChannelBadges();

        try {
          const res = await fetch('/api/admin/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save-autolaris-channels',
              disabled_autolaris_channels: disabled,
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.success === false) {
            throw new Error(data.error || 'Gagal menyimpan status channel.');
          }
        } catch (err) {
          showMasterNotice(err instanceof Error ? err.message : 'Gagal menyimpan status channel.', true);
        }
      });
    });

    // Test live channel health button
    const testChannelHealthBtn = document.getElementById('btnTestChannelHealth') as HTMLButtonElement | null;
    const channelHealthNotice = document.getElementById('channelHealthNotice');
    const channelHealthNoticeText = document.getElementById('channelHealthNoticeText');

    testChannelHealthBtn?.addEventListener('click', async () => {
      if (!testChannelHealthBtn) return;
      testChannelHealthBtn.disabled = true;
      testChannelHealthBtn.setAttribute('aria-busy', 'true');
      testChannelHealthBtn.textContent = 'Memeriksa...';
      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'test-autolaris-channels' }),
        });
        const payload = await res.json().catch(() => ({}));
        if (!res.ok || payload.success === false) throw new Error(payload.error || 'Gagal memeriksa kesiapan channel.');
        
        const channels: Array<{ code: string; status: string; message: string }> = payload.data?.channels || [];
        channels.forEach((ch) => {
          const badgeEl = document.getElementById(`channel-badge-${ch.code}`);
          if (!badgeEl) return;
          if (ch.status === 'ready') {
            badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-emerald-500"></span> ● Aktif & Siap';
            badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800';
          } else if (ch.status === 'disabled_by_store') {
            badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-amber-500"></span> ○ Nonaktif (Disembunyikan)';
            badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-[10px] font-bold text-amber-800';
          } else if (ch.status === 'unverified') {
            badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-rose-600"></span> ⚠ Key Ditolak Server';
            badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-rose-200 bg-rose-50 px-2.5 py-0.5 text-[10px] font-bold text-rose-800';
          } else {
            badgeEl.innerHTML = '<span class="size-1.5 rounded-full bg-slate-400"></span> ⚠ Belum Dikonfigurasi';
            badgeEl.className = 'inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-[10px] font-bold text-slate-700';
          }
        });

        if (channelHealthNotice && channelHealthNoticeText) {
          channelHealthNoticeText.textContent = payload.message || 'Pemeriksaan kesiapan channel AutoLaris selesai.';
          channelHealthNotice.hidden = false;
        }
      } catch (err) {
        if (channelHealthNotice && channelHealthNoticeText) {
          channelHealthNoticeText.textContent = err instanceof Error ? err.message : 'Pemeriksaan kesiapan channel gagal.';
          channelHealthNotice.hidden = false;
        }
      } finally {
        testChannelHealthBtn.disabled = false;
        testChannelHealthBtn.setAttribute('aria-busy', 'false');
        testChannelHealthBtn.textContent = 'Periksa Kesiapan Channel Live';
      }
    });

    // Load store & payment options settings
    void fetch('/api/admin/settings', { headers: { Accept: 'application/json' } })
      .then(async (response) => {
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Status kredensial gagal dimuat.');
        const credential = payload.data?.credentials?.autolaris;
        const apiReady = Boolean(credential?.api_key_configured);
        const callbackReady = Boolean(credential?.webhook_secret_configured);
        stateStoreSettings.api_key_ready = apiReady;

        disabledChannels = Array.isArray(payload.data?.store?.disabled_autolaris_channels)
          ? payload.data.store.disabled_autolaris_channels
          : [];

        if (codToggle) codToggle.checked = payload.data?.store?.is_cod_enabled !== false;
        if (autolarisToggle) autolarisToggle.checked = payload.data?.store?.is_autolaris_enabled !== false;
        stateStoreSettings.is_cod_enabled = codToggle?.checked ?? true;
        stateStoreSettings.is_autolaris_enabled = autolarisToggle?.checked ?? true;

        if (autolarisCredStatus) {
          autolarisCredStatus.textContent = apiReady ? 'Tersimpan & Siap' : 'Belum Dikonfigurasi';
          autolarisCredStatus.className = apiReady ? 'text-emerald-700' : 'text-rose-700';
        }

        if (masked) masked.textContent = credential?.api_key_masked || 'Belum diatur';
        if (secretMasked) secretMasked.textContent = credential?.webhook_secret_masked || 'Belum diatur';
        if (feeBearerToggle) {
          feeBearerToggle.checked = payload.data?.store?.payment_fee_bearer !== 'seller';
          syncFeePolicyCard('online', feeBearerToggle.checked);
        }
        if (codFeeBearerToggle) {
          codFeeBearerToggle.checked = payload.data?.store?.cod_fee_bearer !== 'seller';
          syncFeePolicyCard('cod', codFeeBearerToggle.checked);
        }
        for (const [node, ready] of [[badge, apiReady], [secretBadge, callbackReady]] as const) {
          if (!node) continue;
          node.textContent = ready ? 'Tersimpan' : 'Belum diatur';
          node.className = `rounded-md px-2 py-0.5 text-[10px] font-bold ${ready ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`;
        }
        if (testBtn) testBtn.disabled = !apiReady;
        updateChannelBadges();
        showMessage(
          apiReady && callbackReady
            ? 'API key dan callback secret tersimpan. Integrasi AutoLaris siap secara konfigurasi lokal.'
            : !apiReady && !callbackReady
              ? 'API key dan callback secret belum diatur. Pembayaran AutoLaris belum dapat digunakan; order COD tetap berjalan.'
              : !apiReady
                ? 'Callback secret sudah tersimpan, tetapi API key belum diatur. Pembuatan transaksi AutoLaris belum siap.'
                : 'API key sudah tersimpan, tetapi callback secret belum diatur. Rekonsiliasi callback belum siap.',
          apiReady && callbackReady ? 'ready' : 'setup',
        );
        updateMasterBadges();
      })
      .catch((error) => {
        if (masked) masked.textContent = 'Gagal memuat';
        if (secretMasked) secretMasked.textContent = 'Gagal memuat';
        if (badge) badge.textContent = 'Tidak tersedia';
        if (secretBadge) secretBadge.textContent = 'Tidak tersedia';
        if (testBtn) testBtn.disabled = true;
        showMessage(error instanceof Error ? error.message : 'Status kredensial gagal dimuat.', 'error');
        updateMasterBadges();
      });
    void fetch('/api/payment-methods', { cache: 'no-store' })
      .then(async (r) => {
        const d = (await r.json().catch(() => ({}))) as any;
        if (!r.ok || d.success === false || !Array.isArray(d.data)) return;
        const manualAccounts = d.data.filter((item: any) => item.payment_method === 'manual_transfer' && item.is_active);
        if (manualBankBadge && manualBankCountLabel) {
          if (manualAccounts.length > 0) {
            manualBankBadge.innerHTML = `<span class="size-1.5 rounded-full bg-emerald-500"></span> ● ${manualAccounts.length} Rekening Aktif`;
            manualBankBadge.className = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-emerald-50 text-emerald-800 border-emerald-200';
            manualBankCountLabel.textContent = `${manualAccounts.length} Rekening Tampil di Checkout`;
            manualBankCountLabel.className = 'text-emerald-700 font-bold';
          } else {
            manualBankBadge.innerHTML = '<span class="size-1.5 rounded-full bg-slate-400"></span> ○ Semua Nonaktif';
            manualBankBadge.className = 'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold bg-slate-100 text-slate-600 border-slate-200';
            manualBankCountLabel.textContent = 'Semua Nonaktif (Disembunyikan)';
            manualBankCountLabel.className = 'text-slate-500 font-bold';
          }
        }
      })
      .catch(() => {});

    testBtn?.addEventListener('click', async () => {
      if (!testBtn) return;
      testBtn.disabled = true;
      testBtn.setAttribute('aria-busy', 'true');
      testBtn.textContent = 'Memeriksa konfigurasi…';
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'test-autolaris' }),
        });
        const data = await response.json().catch(() => ({}));
        showMessage(data.message || data.error || (response.ok ? 'Konfigurasi lokal AutoLaris tersedia.' : 'Konfigurasi AutoLaris belum siap.'), response.ok && data.success !== false ? 'ready' : 'error');
      } catch (error) {
        showMessage(error instanceof Error ? error.message : 'Pemeriksaan konfigurasi AutoLaris gagal.', 'error');
      } finally {
        testBtn.disabled = false;
        testBtn.setAttribute('aria-busy', 'false');
        testBtn.textContent = 'Periksa kesiapan lokal';
      }
    });

    saveFeePolicyBtn?.addEventListener('click', async () => {
      if (!saveFeePolicyBtn) return;
      saveFeePolicyBtn.disabled = true;
      saveFeePolicyBtn.setAttribute('aria-busy', 'true');
      if (feePolicyStatus) feePolicyStatus.textContent = 'Menyimpan…';
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save-payment-fee-policy',
            payment_fee_bearer: feeBearerToggle?.checked ? 'buyer' : 'seller',
            cod_fee_bearer: codFeeBearerToggle?.checked ? 'buyer' : 'seller',
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload.success === false) {
          throw new Error(payload.error || 'Kebijakan biaya gagal disimpan.');
        }
        if (feePolicyStatus) {
          feePolicyStatus.textContent = payload.message || 'Kebijakan biaya disimpan.';
          feePolicyStatus.className = 'text-xs font-bold text-emerald-700';
        }
      } catch (error) {
        if (feePolicyStatus) {
          feePolicyStatus.textContent = error instanceof Error ? error.message : 'Kebijakan biaya gagal disimpan.';
          feePolicyStatus.className = 'text-xs font-bold text-rose-700';
        }
      } finally {
        saveFeePolicyBtn.disabled = false;
        saveFeePolicyBtn.setAttribute('aria-busy', 'false');
      }
    });
  </script>
</AdminLayout>
