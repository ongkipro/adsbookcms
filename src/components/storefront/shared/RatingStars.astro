---
interface Props {
  rating?: number;
  max?: number;
  class?: string;
  starClass?: string;
  label?: string;
}

const {
  rating = 5,
  max = 5,
  class: className = '',
  starClass = 'h-3 w-3',
  label = `${rating} dari ${max} bintang`,
} = Astro.props;
---

<span class={`inline-flex items-center gap-0.5 ${className}`} aria-label={label} role="img">
  {
    Array.from({ length: max }).map((_, index) => {
      const active = index < Math.round(rating);
      return (
        <svg
          viewBox="0 0 20 20"
          class={`${starClass} ${active ? 'fill-[#111111] text-[#111111]' : 'fill-[#E5E5E5] text-[#E5E5E5]'}`}
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M10 1.45l2.58 5.23 5.77.84-4.18 4.07.99 5.75L10 14.62 4.84 17.34l.99-5.75L1.65 7.52l5.77-.84L10 1.45Z"
          />
        </svg>
      );
    })
  }
</span>
