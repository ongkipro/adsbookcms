# AdsBookCMS — Environment Configuration Template
# Local development only. Configure production credentials with `wrangler secret put`; never commit `.env`.

# 1. Cloudflare D1 & R2 Configuration
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_DATABASE_ID="your_d1_database_id"
CLOUDFLARE_D1_TOKEN="your_cloudflare_d1_api_token"

# 2. Mengantar API Credentials (Multi-Courier Logistics Aggregator)
MENGANTAR_API_KEY="API-YOUR_REAL_MENGANTAR_API_KEY"
MENGANTAR_BASE_URL="https://api-public.mengantar.com"
MENGANTAR_ORIGIN_AREA_ID="5fc62f63f8f44b34aa4c0e0a" # Default Jakarta Origin
MENGANTAR_PICKUP_ADDRESS_ID="60a7e58129a00812ab99011a"

# 3. AutoLaris Payment Gateway Credentials (Bank Transfer Auto-Check & QRIS)
AUTOLARIS_API_KEY="al_live_YOUR_AUTOLARIS_API_KEY"
AUTOLARIS_BASE_URL="https://api-h2h.autolaris.com"
AUTOLARIS_WEBHOOK_SECRET="whsec_YOUR_AUTOLARIS_WEBHOOK_SECRET"

# 4. Meta Ads & Conversions API (CAPI) Tracking
META_PIXEL_ID="123456789012345"
META_CAPI_ACCESS_TOKEN="EAAB_YOUR_META_CAPI_ACCESS_TOKEN"

# 5. Google Ads Conversion Tracking
GOOGLE_ADS_CONVERSION_ID="AW-123456789"
GOOGLE_ADS_CONVERSION_LABEL="AbCd_EfGhIjKlMn"

# 6. Admin Session Security (production value must be a Cloudflare secret)
AUTH_SECRET="replace_with_at_least_32_random_characters"
INSTALL_TOKEN="replace_with_a_unique_setup_token_at_least_16_characters"
BOOTSTRAP_ADMIN_PASSWORD="set_a_unique_one_time_admin_password_min_16_chars"

# 7. Optional redacted operational alert webhook (HTTPS; configure as a Worker secret)
OPS_ALERT_WEBHOOK_URL=""

# 8. Excluded COD Zones (Comma-separated list of provinces)
PUBLIC_COD_DISABLED_PROVINCES="papua,papua barat,papua barat daya,papua tengah,papua pegunungan,papua selatan,maluku,maluku utara,nusa tenggara timur,kalimantan utara,sulawesi barat,gorontalo,kepulauan riau,aceh,bengkulu"
