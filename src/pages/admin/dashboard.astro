---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AnalyticsDashboard } from '../../components/admin/AnalyticsDashboard';
import OperationalHealth from '../../components/admin/OperationalHealth';
import { getSchemaVersionStatus } from '../../lib/schema-version';
import { canAccessAdminRoute } from '../../lib/auth';

export const prerender = false;

// One SELECT COUNT(*) per isolate, on this page only. A mismatch is shown, not
// thrown: a schema drift must never take a working store offline.
const adminRole = Astro.locals.admin?.role ?? 'customer_service';
const mayViewHealth = canAccessAdminRoute(adminRole, '/api/admin/health');
const mayManageOrders = canAccessAdminRoute(adminRole, '/admin/orders');
const mayManagePayments = canAccessAdminRoute(adminRole, '/admin/payments');
const primaryActions = mayManageOrders
  ? [
      { href: '/admin/orders', label: 'Kelola order', primary: false },
      { href: '/admin/shipping', label: 'Buka pengiriman', primary: true },
    ]
  : [
      { href: '/admin/products', label: 'Kelola produk', primary: false },
      { href: '/admin/ads', label: 'Buka Ads', primary: true },
    ];
const schema = mayViewHealth ? await getSchemaVersionStatus(Astro.locals) : { state: 'match' as const };
const schemaNotice = schema.state === 'database-behind'
  ? `Database toko masih di migrasi ke-${schema.applied}, sedangkan aplikasi ini dibangun untuk ke-${schema.expected}. Jalankan \`wrangler d1 migrations apply OMS_DB --remote\` sebelum memakai fitur baru — query yang belum punya kolomnya akan gagal.`
  : schema.state === 'database-ahead'
    ? `Database toko sudah di migrasi ke-${schema.applied}, lebih baru dari aplikasi ini (ke-${schema.expected}). Deploy build terbaru; versi ini kemungkinan tidak mengenal kolom yang sudah ada.`
    : schema.state === 'unknown'
      ? 'Versi skema database tidak bisa dibaca (tabel `d1_migrations` tidak ada atau tidak terbaca), jadi kecocokan aplikasi dengan database tidak bisa dipastikan.'
      : '';
---

<AdminLayout title="Dashboard" activeMenu="dashboard">
  <div class="space-y-4 md:space-y-5">
    <header class="flex flex-col gap-3 border-b border-slate-200/80 pb-4 sm:flex-row sm:items-end sm:justify-between sm:pb-5">
      <div>
        <h2 class="text-2xl font-semibold tracking-[-0.035em] text-slate-950 md:text-3xl">Ringkasan bisnis</h2>
        <p class="mt-1 max-w-2xl text-sm leading-5 text-slate-500 md:leading-6">Pantau penjualan, pembayaran, dan risiko operasional dalam satu tampilan.</p>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:flex">
        {primaryActions.map((action) => (
          <a href={action.href} class:list={["inline-flex min-h-11 items-center justify-center rounded-xl px-4 text-xs font-medium", action.primary ? "bg-slate-950 text-white hover:bg-slate-800" : "border border-slate-200 bg-white text-slate-700 hover:bg-slate-50"]}>{action.label}</a>
        ))}
      </div>
    </header>
    {schemaNotice && (
      <div role="status" class="flex flex-col gap-1 rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-900">
        <p class="text-[10px] font-black uppercase tracking-[0.16em] text-amber-700">Peringatan skema database</p>
        <p class="text-sm leading-5">{schemaNotice}</p>
      </div>
    )}
    <AnalyticsDashboard client:only="react" showPaymentsLink={mayManagePayments} />
    {mayViewHealth && <OperationalHealth client:only="react" />}
  </div>
</AdminLayout>
