<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;

    const createEventId = (prefix) => `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    const pushGtmEcomEvent =
      window.__PS_PUSH_GTM_ECOM__ ||
      ((event, payload) => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({
          event,
          tracking_owner: 'app',
          meta_managed_by_app: true,
          meta_event_id: payload.event_id,
          ecommerce: {
            currency: payload.currency || 'IDR',
            value: Number(payload.value || 0),
            transaction_id: payload.transaction_id,
            items: [
              {
                item_id: payload.item_id || '',
                item_name: payload.item_name || '',
                item_variant: payload.item_variant,
                quantity: 1,
              },
            ],
          },
        });
      });
    const postMeta = (payload) => {
      fetch('/api/meta-event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).catch(() => {});
    };

    const pathname = window.location.pathname || '/';
    const contentName = document.title || pathname;
    const eventId = window.__META_PAGEVIEW_EVENT_ID__ || createEventId('pv');
    postMeta({
      event_name: 'PageView',
      event_id: eventId,
      lp_name: pathname,
      content_name: contentName,
      value: 1,
      currency: 'IDR',
      content_type: 'page',
      event_source_url: window.location.href,
    });
    pushGtmEcomEvent('page_view', {
      currency: 'IDR',
      value: 1,
      item_id: pathname,
      item_name: contentName,
      event_id: eventId,
    });
  })();
</script>
