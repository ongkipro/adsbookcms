---
import { cn } from '../../../lib/cn';
import { listItemVariants, textVariants } from '../../../lib/ui-variants';
import PageIntro from './PageIntro.astro';

interface LegalSection {
  title: string;
  paragraphs: string[];
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  badge: string;
  title: string;
  description: string;
  sections: LegalSection[];
  breadcrumbs?: BreadcrumbItem[];
}

const { badge, title, description, sections, breadcrumbs = [] } = Astro.props;
---

<main id="konten-utama" class="min-h-screen bg-[#FAFAFA] text-[#263238]">
  <PageIntro badge={badge} title={title} description={description} breadcrumbs={breadcrumbs} />

  <section class="mx-auto max-w-[480px] px-5 py-8">
    <div class="space-y-6">
      {
        sections.map((section) => (
          <article class={listItemVariants({ density: 'featured' })}>
            <h2 class={cn('text-[18px] font-semibold tracking-[-0.01em]', textVariants({ tone: 'heading' }))}>
              {section.title}
            </h2>
            <div class={cn('mt-3 space-y-4 text-[14px] leading-7', textVariants({ tone: 'body' }))}>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</main>
