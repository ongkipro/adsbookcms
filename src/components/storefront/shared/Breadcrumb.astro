---
import { cn } from '../../../lib/cn';
import {
  RAIL_WIDTH_CLASS,
  resolveContentWidth,
  type ContentWidth,
} from '../../../lib/storefront-width';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  /** Follows the page, not the store template, so an overridden shell agrees. */
  contentWidth?: ContentWidth;
}

const { items, contentWidth } = Astro.props;
const rail =
  RAIL_WIDTH_CLASS[
    resolveContentWidth(Astro.locals.tenant.storefrontTemplate, contentWidth)
  ];
---

<nav aria-label="Breadcrumb" class="border-b border-[#E5E5E5] bg-[#F8F7F4] px-4 py-2">
  <div
    class={cn(
      'mx-auto flex min-w-0 items-center gap-1.5 overflow-hidden text-[11px] text-[#555555]',
      rail,
    )}
  >
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;

        return (
          <>
            {index > 0 && <span class="shrink-0 text-[#A3A09A]">/</span>}
            {item.href ? (
              <a href={item.href} class="shrink-0 transition-colors hover:text-[#C5A880]">
                {item.label}
              </a>
            ) : (
              <span
                class="min-w-0 max-w-[58%] truncate font-medium text-[#111111] sm:max-w-[65%]"
                aria-current={isLast ? 'page' : undefined}
              >
                {item.label}
              </span>
            )}
          </>
        );
      })
    }
  </div>
</nav>
