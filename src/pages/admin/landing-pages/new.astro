---
import LandingPageEditor from '../../../components/admin/LandingPageEditor';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';

export const prerender = false;
---

<AdminLayout title="Buat landing page" activeMenu="products">
  <div class="space-y-5">
    <AdminPageHeader
      title="Buat landing page"
      description="Rancang dan bangun halaman promosi Anda."
    >
      <div slot="actions">
        <a href="/admin/landing-pages" class="btn-secondary">Kembali</a>
      </div>
    </AdminPageHeader>
    <LandingPageEditor client:only="react" />
  </div>
</AdminLayout>
