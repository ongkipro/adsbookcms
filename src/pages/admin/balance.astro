---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
import PaymentReconciliationQueue from "../../components/admin/PaymentReconciliationQueue";

export const prerender = false;
---

<AdminLayout title="Verifikasi pembayaran AutoLaris" activeMenu="payments">
  <div class="mx-auto max-w-7xl space-y-5">
    <AdminPageHeader
      eyebrow="Payment operations"
      title="Verifikasi pembayaran AutoLaris"
      description="Periksa pembayaran QRIS dan virtual account yang masih menunggu, lalu konfirmasi hanya setelah transaksi terlihat berhasil di dashboard AutoLaris."
      backHref="/admin/payments"
      backLabel="Payment AutoLaris"
    />

    <PaymentReconciliationQueue client:load />
  </div>
</AdminLayout>
