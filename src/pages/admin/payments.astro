---
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import PaymentSettings from '../../components/admin/PaymentSettings';
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  AUTOLARIS_CHECKOUT_CHANNELS,
  autoLarisChannelLockReason,
} from '../../lib/autolaris-client';
import { paymentFeeDescription } from '../../lib/payment-fee-policy';

export const prerender = false;

const channelLabels: Record<(typeof AUTOLARIS_CHECKOUT_CHANNELS)[number], string> = {
  QRIS: 'QRIS (BCA, Mandiri, GoPay, OVO, ShopeePay, Dana, LinkAja)',
  VABCA: 'Virtual Account BCA',
  VAMANDIRI: 'Virtual Account Mandiri',
  VABNI: 'Virtual Account BNI',
  VABRI: 'Virtual Account BRI',
  VAPERMATA: 'Virtual Account Permata',
  VABSI: 'Virtual Account BSI',
  VACIMB: 'Virtual Account CIMB Niaga',
  VADANAMON: 'Virtual Account Danamon',
};

const callbackUrl = new URL('/api/webhooks/autolaris', Astro.url.origin).toString();
const channels = AUTOLARIS_CHECKOUT_CHANNELS.map((code) => ({
  code,
  label: channelLabels[code],
  feeDescription: paymentFeeDescription(code),
  lockReason: autoLarisChannelLockReason(code) || undefined,
}));
---

<AdminLayout title="Metode Pembayaran & Payment Gateway" activeMenu="payments">
  <div class="max-w-6xl space-y-6">
    <AdminPageHeader
      eyebrow="Payments & Gateways"
      title="Metode Pembayaran"
      description="Kelola ketersediaan metode checkout, channel AutoLaris, biaya transaksi, kesiapan callback, dan rekening transfer dari satu workspace."
    />

    <PaymentSettings client:load callbackUrl={callbackUrl} channels={channels} />
  </div>
</AdminLayout>
