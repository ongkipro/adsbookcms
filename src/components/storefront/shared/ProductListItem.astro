---
import { cardImageSrc } from '../../../lib/image-derivative';

interface ProductVariant {
  id: string;
  label: string;
  price: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    tag?: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
}

const { product, formatPrice } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
const discountPercentage = hasDiscount
  ? Math.round((1 - product.price / comparePrice) * 100)
  : 0;
---

<article class="group h-full rounded-none border border-[#E5E5E5] bg-white">
  <a
    href={`/produk/${product.slug}`}
    class="flex h-full flex-col rounded-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C5A880]"
  >
    <div class="relative aspect-[3/4] overflow-hidden border-b border-[#E5E5E5] bg-[#F8F7F4]">
      <img
        src={cardImageSrc(product.heroImage)}
        alt={`Foto produk ${product.productName}`}
        width="320"
        height="426"
        class="h-full w-full rounded-none object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        loading="lazy"
        decoding="async"
      />
      {discountPercentage > 0 && (
        <span class="absolute left-2 top-2 rounded-none bg-[#C5A880] px-2 py-1 text-[9px] font-semibold uppercase tracking-[0.12em] text-[#111111]">
          -{discountPercentage}%
        </span>
      )}
    </div>

    <div class="flex flex-1 flex-col p-3">
      <p class="text-[9px] font-semibold uppercase tracking-[0.15em] text-[#555555]">
        {product.category}
      </p>
      <h2 class="mt-1 line-clamp-2 min-h-10 text-sm font-semibold leading-5 text-[#111111]">
        {product.productName}
      </h2>

      <div class="mt-3">
        {hasDiscount && (
          <p class="text-[10px] leading-4 text-[#777777] line-through">
            {formatPrice(comparePrice)}
          </p>
        )}
        <p class="text-sm font-bold leading-5 text-[#111111]">{formatPrice(product.price)}</p>
      </div>

      <div class="mt-auto flex items-center justify-between gap-2 border-t border-[#E5E5E5] pt-3 text-[10px] text-[#555555]">
        {product.tag ? <span class="min-w-0 truncate">{product.tag}</span> : <span aria-hidden="true"></span>}
        <span class="shrink-0">{product.variants.length} varian</span>
      </div>
    </div>
  </a>
</article>
