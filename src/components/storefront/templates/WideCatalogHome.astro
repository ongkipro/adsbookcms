---
import type { TenantHomeContent } from '../../../lib/tenant-content';

interface ProductCard {
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  variants: Array<{ label: string; price: number }>;
}

interface Props {
  content: TenantHomeContent;
  products: ProductCard[];
  tenantName: string;
  logo: string;
  accent: string;
  sections: {
    hero: boolean;
    catalog: true;
    proofs: boolean;
  };
}

const { content, products, tenantName, sections } = Astro.props;
const featuredProduct = products[0];
---

<div class="min-h-screen bg-[#FBFBFB] text-zinc-950 font-sans">
  <main id="konten-utama">
    <!-- Hero Showcase Section -->
    {sections.hero && (<section class="relative overflow-hidden bg-gradient-to-b from-white via-[#FBFBFB] to-zinc-100/60 border-b border-zinc-200/80">
      <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-20 grid gap-12 md:grid-cols-12 md:items-center">
        <div class="md:col-span-7 space-y-6">
          {content.hero.ratingLabel && (
            <div class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-white shadow-xs">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              <span>{content.hero.ratingLabel}</span>
            </div>
          )}

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.04em] leading-[1.05] text-zinc-950">
            {content.hero.title || tenantName}
          </h1>

          <p class="max-w-[56ch] text-base sm:text-lg leading-relaxed text-zinc-600 font-normal">
            {content.hero.description || 'Jelajahi berbagai pilihan produk unggulan kami.'}
          </p>
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#katalog"
              class="inline-flex min-h-12 items-center justify-center rounded-full bg-zinc-950 px-8 text-sm font-bold tracking-wide text-white transition-all hover:bg-zinc-800 hover:shadow-lg active:scale-98"
            >
              Jelajahi Koleksi
            </a>
            <a
              href="/produk"
              class="inline-flex min-h-12 items-center justify-center rounded-full border border-zinc-300 bg-white px-7 text-sm font-semibold text-zinc-800 transition-all hover:bg-zinc-50 hover:border-zinc-400"
            >
              Semua Produk ({products.length})
            </a>
          </div>
        </div>

        {featuredProduct && (
          <div class="md:col-span-5">
            <a
              href={featuredProduct.href}
              class="group relative block transition-all duration-300 hover:-translate-y-1"
            >
              <div class="aspect-[3/4] w-full overflow-hidden rounded-2xl bg-zinc-50 flex items-center justify-center">
                <img
                  src={featuredProduct.image}
                  alt={featuredProduct.name}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="mt-4 space-y-2">
                <span class="text-[11px] font-extrabold uppercase tracking-widest text-emerald-700">
                  {featuredProduct.category}
                </span>
                <h2 class="text-xl font-bold text-zinc-950 group-hover:text-emerald-700 transition-colors">
                  {featuredProduct.name}
                </h2>
                <div class="flex items-center justify-between pt-2">
                  <div>
                    <p class="text-xs text-zinc-500">Harga</p>
                    <p class="text-xl font-extrabold text-zinc-950">
                      Rp{featuredProduct.price.toLocaleString('id-ID')}
                    </p>
                  </div>
                  <span class="inline-flex items-center rounded-full bg-emerald-50 px-3.5 py-1.5 text-xs font-extrabold text-emerald-800 border border-emerald-200">
                    Beli Sekarang
                  </span>
                </div>
              </div>
            </a>
          </div>
        )}
      </div>
    </section>)}

    <!-- Catalog Section -->
    {sections.catalog && (<section id="katalog" class="mx-auto max-w-7xl px-5 py-16 md:px-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-zinc-200/80 pb-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.15em] text-emerald-700">
            Katalog Pilihan
          </span>
          <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-[-0.03em] text-zinc-950">
            {content.catalog.title || 'Katalog Produk'}
          </h2>
        </div>
        {content.catalog.description && (
          <p class="max-w-[42ch] text-sm text-zinc-600 leading-relaxed">
            {content.catalog.description}
          </p>
        )}
      </div>

      <!-- Product Cards Grid: Flat Minimalist without card borders -->
      <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        {products.map((product) => {
          const comparePrice = product.comparePrice ?? 0;
          const discount = comparePrice > product.price 
            ? Math.round((1 - product.price / comparePrice) * 100) 
            : 0;
          return (
            <article class="group flex flex-col transition-all duration-300">
              <a href={product.href} class="relative block aspect-[3/4] w-full overflow-hidden rounded-2xl bg-zinc-100/80">
                <img
                  src={product.image}
                  alt={product.name}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                {discount > 0 && (
                  <span class="absolute top-3 left-3 rounded-full bg-zinc-950/85 backdrop-blur-xs px-2.5 py-1 text-[10px] font-extrabold text-white shadow-xs">
                    Diskon {discount}%
                  </span>
                )}
              </a>

              <div class="mt-4 flex flex-1 flex-col space-y-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700">
                  {product.category}
                </span>
                <h3 class="text-sm font-bold text-zinc-950 line-clamp-2 leading-snug group-hover:text-emerald-700 transition-colors">
                  <a href={product.href}>{product.name}</a>
                </h3>

                <div class="pt-1 flex items-baseline gap-2">
                  <p class="text-base font-extrabold text-zinc-950">
                    Rp{product.price.toLocaleString('id-ID')}
                  </p>
                  {comparePrice > product.price && (
                    <p class="text-xs text-zinc-400 line-through">
                      Rp{comparePrice.toLocaleString('id-ID')}
                    </p>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>)}

  </main>
</div>
