---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { OrdersTable, type OrderItem } from '../../../components/admin/OrdersTable';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { getRuntimeEnv } from '../../../lib/env';

export const prerender = false;

type AdminLocalsWithDatabase = App.Locals & {
  OMS_DB?: D1Database;
};

type InitialOrderDatabaseRow = Omit<OrderItem, 'dispatchEligible'> & {
  dispatchEligible: number;
};

const localDatabase = (Astro.locals as AdminLocalsWithDatabase).OMS_DB;
const database =
  localDatabase ??
  (getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
let initialOrders: OrderItem[] | undefined;

if (database?.prepare) {
  try {
    const result = await database
      .prepare(`
        SELECT
          CAST(orders.id AS TEXT) AS id,
          orders.order_number AS orderNumber,
          orders.customer_name AS customerName,
          orders.customer_phone AS customerPhone,
          COALESCE(orders.address, '') AS address,
          COALESCE((
            SELECT GROUP_CONCAT(COALESCE(products.title, product_variants.title, ''), ', ')
            FROM order_items
            LEFT JOIN product_variants ON product_variants.id = order_items.variant_id
            LEFT JOIN products ON products.id = product_variants.product_id
            WHERE order_items.order_id = orders.id
          ), '') AS productName,
          COALESCE((
            SELECT GROUP_CONCAT(product_variants.title, ', ')
            FROM order_items
            LEFT JOIN product_variants ON product_variants.id = order_items.variant_id
            WHERE order_items.order_id = orders.id
          ), '') AS variantName,
          COALESCE((
            SELECT SUM(order_items.quantity * order_items.unit_price)
            FROM order_items
            WHERE order_items.order_id = orders.id
          ), 0) AS productPrice,
          COALESCE(orders.shipping_cost, 0) AS shippingCost,
          COALESCE(orders.district, '') AS district,
          COALESCE(orders.city, '') AS city,
          COALESCE(orders.province, '') AS province,
          COALESCE(orders.total_amount, 0) AS totalAmount,
          COALESCE(orders.payment_method, '') AS paymentMethod,
          COALESCE(orders.payment_status, '') AS paymentStatus,
          COALESCE(orders.shipping_status, '') AS shippingStatus,
          COALESCE(orders.courier_code, '') AS courierCode,
          COALESCE(orders.cnote_no, '') AS cnoteNo,
          COALESCE((
            SELECT stores.name
            FROM stores
            WHERE stores.id = orders.store_id
          ), '') AS sellerName,
          TRIM(
            COALESCE(orders.seller_bank_name, '') || ' ' ||
            COALESCE(orders.seller_account_number, '') ||
            CASE
              WHEN orders.seller_account_holder IS NULL OR orders.seller_account_holder = '' THEN ''
              ELSE ' a.n. ' || orders.seller_account_holder
            END
          ) AS bankAccounts,
          COALESCE((
            SELECT payment_transactions.provider_payment_url
            FROM payment_transactions
            WHERE payment_transactions.order_id = orders.id
            ORDER BY payment_transactions.id DESC
            LIMIT 1
          ), '') AS epaymentLink,
          COALESCE(orders.receiver_rts_score, -1) AS receiverDeliveryRate,
          CASE
            WHEN UPPER(COALESCE(orders.rts_risk_label, '')) LIKE '%HIGH%' THEN 'HIGH'
            WHEN UPPER(COALESCE(orders.rts_risk_label, '')) LIKE '%MEDIUM%' THEN 'MEDIUM'
            WHEN UPPER(COALESCE(orders.rts_risk_label, '')) LIKE '%LOW%' THEN 'LOW'
            ELSE 'UNKNOWN'
          END AS receiverRiskLabel,
          orders.created_at AS createdAt,
          0 AS dispatchEligible,
          '' AS dispatchReason,
          orders.provider_dispatch_error AS providerDispatchError,
          orders.provider_order_id AS providerOrderId,
          orders.ad_click_ids AS adClickIds
        FROM orders
        ORDER BY orders.id DESC
        LIMIT 20
      `)
      .all<InitialOrderDatabaseRow>();

    initialOrders = result.results.map(
      ({ dispatchEligible, ...order }): OrderItem => ({
        ...order,
        dispatchEligible: Boolean(dispatchEligible),
      }),
    );
  } catch (error) {
    console.error('admin-orders-initial-load', error);
  }
}
---

<AdminLayout title="Order Management" activeMenu="orders">
  <div class="space-y-5">
    <AdminPageHeader
      eyebrow="Commerce operations"
      title="Order management"
      description="Validasi pembayaran, alamat, risiko RTS, kurir, dan gudang. Konfirmasi order yang siap agar masuk ke antrean Pengiriman."
    >
      <div slot="actions" class="grid grid-cols-2 gap-2 sm:flex">
        <a href="/admin/check" class="btn-secondary min-h-11 px-4 text-xs">Cek risiko</a>
        <a href="/admin/shipping" class="btn-primary min-h-11 px-4 text-xs">Pengiriman</a>
      </div>
    </AdminPageHeader>
    <OrdersTable initialOrders={initialOrders} client:load />
  </div>
</AdminLayout>
