{
  "name": "adsbookcms",
  "version": "1.3.0",
  "description": "AdsBookCMS — single-install direct-response commerce CMS for Cloudflare Workers",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "preview": "astro preview",
    "cf:dev": "wrangler dev --local",
    "cf:deploy": "wrangler deploy",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply OMS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply OMS_DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/react": "^6.0.2",
    "@base-ui/react": "^1.7.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.111",
    "@iconify/utils": "^3.1.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.2.0",
    "astro-seo": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.7.3",
    "wrangler": "^4.120.0"
  }
}
