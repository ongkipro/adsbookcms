---
interface Proof {
  name: string;
  location: string;
  story: string;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  proofs: Proof[];
  heading: Heading;
}

const { proofs, heading } = Astro.props;
---

{
  proofs.length > 0 && (
    <section id="bukti" class="border-t border-[#E5E5E5] bg-[#F8F7F4] px-5 py-8">
      <div class="mb-5 text-left">
        <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#8A704F]">
          {heading.eyebrow}
        </span>
        <h2 class="mt-1 text-xl font-bold tracking-tight text-[#111111]">{heading.title}</h2>
        <p class="mt-1.5 text-xs font-normal leading-relaxed text-[#555555]">{heading.description}</p>
      </div>

      <div class="mt-4 flex flex-col gap-3.5">
        {proofs.map((proof) => (
          <article class="border border-[#E5E5E5] bg-white p-4 shadow-2xs">
            <div class="flex items-start gap-3.5">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center border border-[#C5A880]/60 bg-[#111111] text-[13px] font-bold uppercase text-[#C5A880]"
                style="font-family: 'Cinzel', serif;"
                aria-hidden="true"
              >
                {proof.name.charAt(0)}
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="truncate text-xs font-bold text-[#111111]">{proof.name}</h3>
                <p class="mt-0.5 text-[10px] font-normal text-[#77736C]">{proof.location}</p>
                <p class="mt-2 text-xs leading-relaxed text-[#555555]">"{proof.story}"</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}
