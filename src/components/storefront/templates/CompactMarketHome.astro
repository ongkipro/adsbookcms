---
import HeroSection from '../../home/HeroSection.astro';
import ProductsSection from '../../home/ProductsSection.astro';
import ProofsSection from '../../home/ProofsSection.astro';
import type { TenantHomeContent } from '../../../lib/tenant-content';

interface ProductCard {
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants: Array<{ label: string; price: number }>;
}

interface Props {
  content: TenantHomeContent;
  products: ProductCard[];
}

const { content, products } = Astro.props;

const heroSlides =
  content.heroSlides.length > 0
    ? content.heroSlides
    : products.slice(0, 3).map((product) => ({
        image: product.image,
        alt: product.name,
        badge: product.category,
        text: product.name,
      }));
---

<main
  id="konten-utama"
  class="relative min-h-screen overflow-x-hidden bg-[#F8F7F4] font-sans text-[#111111] antialiased"
>
  <div
    id="home"
    class="mx-auto flex min-h-screen w-full max-w-[480px] flex-col border-x border-[#E5E5E5] bg-[#F8F7F4]"
  >
    <HeroSection slides={heroSlides} highlights={content.heroHighlights} content={content.hero} />
    <ProductsSection products={products} heading={content.catalog} />
    <ProofsSection proofs={content.proofs} heading={content.proofsHeading} />
  </div>
</main>

<script>
  const heroTrack = document.getElementById('hero-track');
  const heroDots = document.getElementById('hero-dots');
  const heroCount = heroTrack?.children.length ?? 0;
  let heroIndex = 0;
  let heroTimer: number | undefined;

  const setHeroSlide = (index: number) => {
    if (!heroTrack || !heroDots) return;
    heroTrack.style.transform = `translateX(-${index * 100}%)`;
    [...heroDots.children].forEach((dot, itemIndex) => {
      dot.className =
        itemIndex === index
          ? 'h-11 w-7 border-b-2 border-white bg-transparent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'
          : 'h-11 w-4 border-b border-white/55 bg-transparent transition-colors hover:border-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
    });
    heroIndex = index;
  };

  const startHero = () => {
    if (heroTimer || heroCount <= 1) return;
    heroTimer = window.setInterval(() => {
      setHeroSlide((heroIndex + 1) % heroCount);
    }, 4000);
  };

  const stopHero = () => {
    if (!heroTimer) return;
    window.clearInterval(heroTimer);
    heroTimer = undefined;
  };

  [...(heroDots?.children ?? [])].forEach((dot, index) => {
    dot.addEventListener('click', () => {
      setHeroSlide(index);
      stopHero();
      startHero();
    });
  });

  const heroContainer = document.getElementById('home');
  heroContainer?.addEventListener('mouseenter', stopHero);
  heroContainer?.addEventListener('mouseleave', startHero);
  startHero();
</script>
