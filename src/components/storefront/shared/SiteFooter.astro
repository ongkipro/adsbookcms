---
const footerLegal = [
  // Four policies plus one way into the catalogue. Meta and Google both want a
  // reachable contact, privacy policy, terms, and a shipping/returns policy
  // before they will run a store's ads; the rest was footer weight. /tentang,
  // /disclaimer, /testimoni and the others still render, still sit in
  // sitemap.xml and can still be linked from anywhere - they just no longer
  // ride along on every page.
  { label: 'Produk', href: '/produk' },
  { label: 'Halaman', href: '/landing-page' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Pengiriman & Retur', href: '/pengiriman' },
];
---

<footer class="border-fade-t bg-white px-5 py-12 text-[#111111]">
  <div class="mx-auto max-w-[480px] space-y-6 text-center">
    <!-- Policy Links -->
    <nav
      aria-label="Tautan footer"
      class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-[10px] font-semibold uppercase tracking-widest text-[#555555]"
    >
      {
        footerLegal.map((item) => (
          <a
            href={item.href}
            class="underline-offset-4 transition-colors hover:text-[#111111] hover:underline focus-visible:text-[#111111] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#111111] focus-visible:ring-offset-2"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Copyright -->
    <p class="text-[10px] uppercase tracking-wider text-[#767676]">
      © {new Date().getFullYear()} {Astro.locals.tenant.name}. All Rights Reserved.
    </p>
  </div>
</footer>
