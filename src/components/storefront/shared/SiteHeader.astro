---
import SiteBrand from './SiteBrand.astro';
import Icon from './Icon.astro';

// One bar, not three (DESIGN-SYSTEM §3). The "Official Store" seal that used
// to sit above it was a verification claim nobody had verified, and the dark
// announcement strip repeated the tagline in 10px capitals. The tagline now
// rides in one quiet line; the header stays put while the buyer scrolls so the
// catalogue is one tap away from anywhere.
const tagline = Astro.locals.tenant.tagline?.trim();
const path = Astro.url.pathname;
// The list is the current page; a product under it is the current location
// ("true"), so a screen reader does not announce the link as this page.
const catalogCurrent = path === '/produk' ? 'page' : path.startsWith('/produk/') ? 'true' : undefined;
---

{tagline && (
  <p class="bg-[#F3F3F3] px-4 py-1.5 text-center text-xs leading-5 text-[#555555]">{tagline}</p>
)}

<header class="sticky top-0 z-30 border-b border-[#EDEDED] bg-white/95 backdrop-blur">
  <div class="flex h-14 items-center justify-between gap-3 pl-3 pr-1.5">
    <SiteBrand href="/" />
    <nav aria-label="Navigasi utama" class="flex items-center">
      <a
        href="/produk"
        aria-current={catalogCurrent}
        class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-sm font-medium text-[#111111] transition-colors hover:bg-[#F3F3F3] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111] aria-[current=page]:bg-[#F3F3F3] aria-[current=true]:bg-[#F3F3F3]"
      >
        <Icon name="lucide:shopping-bag" class="h-[18px] w-[18px]" aria-hidden="true" />
        Produk
      </a>
    </nav>
  </div>
</header>
