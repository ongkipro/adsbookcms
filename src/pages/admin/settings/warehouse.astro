---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
export const prerender = false;
---

<AdminLayout title="Konfigurasi Gudang" activeMenu="settings">
  <div class="space-y-6">
    <AdminPageHeader
      eyebrow="Shipping origin"
      title="Gudang & pickup"
      description="Atur titik asal, PIC, dan pickup ID Mengantar untuk tarif serta jangkauan kurir yang akurat."
      backHref="/admin/settings"
      backLabel="Pengaturan"
    />

    <div id="warehouseLoading" class="h-96 animate-pulse rounded-xl bg-slate-100" role="status" aria-live="polite" aria-busy="true" aria-atomic="true"><span class="sr-only">Memuat konfigurasi gudang.</span></div>
    <div id="warehouseError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-800" role="alert" aria-live="assertive"></div>

    <form id="warehouseForm" class="hidden space-y-0 rounded-xl border border-slate-200 bg-white shadow-sm" novalidate aria-busy="false">

      <!-- Section 1: Identitas Gudang & PIC -->
      <div class="border-b border-slate-100 p-5 md:p-6">
        <p class="mb-4 text-[10px] font-black uppercase tracking-wider text-slate-400">Identitas Gudang & PIC</p>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          <label>
            <span class="mb-1.5 block text-xs font-black text-slate-700">Nama gudang</span>
            <input id="warehouseName" required maxlength="120" placeholder="Contoh: Kedai A29" class="admin-input-flat h-11 text-base md:text-sm" />
          </label>
          <label>
            <span class="mb-1.5 block text-xs font-black text-slate-700">Nama PIC (penanggung jawab)</span>
            <input id="contactName" required maxlength="120" autocomplete="name" placeholder="Contoh: Rini" class="admin-input-flat h-11 text-base md:text-sm" />
          </label>
          <label class="md:col-span-2">
            <span class="mb-1.5 block text-xs font-black text-slate-700">Nomor HP PIC</span>
            <input id="contactPhone" required type="tel" inputmode="numeric" maxlength="16" autocomplete="tel" placeholder="08xxxxxxxxxx" class="admin-input-flat h-11 font-mono text-base md:text-sm" />
            <small id="contactPhoneHint" class="mt-1 block text-xs text-slate-400">Format otomatis ke 62. Contoh: 085854117766 → 6285854117766</small>
          </label>
        </div>
      </div>

      <!-- Section 2: Kecamatan Origin (Pin Pengiriman) -->
      <div class="border-b border-slate-100 p-5 md:p-6">
        <p class="mb-1 text-[10px] font-black uppercase tracking-wider text-slate-400">Pin Origin Pengiriman</p>
        <p class="mb-4 text-xs leading-5 text-slate-500">Kecamatan/kelurahan gudang di database Mengantar. Menentukan titik awal kalkulasi ongkir dan jangkauan kurir.</p>

        <!-- Origin Pin Badge (shown when set) -->
        <div id="originPinBadge" class="mb-4 hidden rounded-xl border border-blue-200 bg-blue-50 p-4">
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" /></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p id="originPinLabel" class="text-sm font-black text-blue-900"></p>
              <p id="originPinMeta" class="mt-0.5 text-xs text-blue-700"></p>
            </div>
            <button id="originPinChange" type="button" class="min-h-11 shrink-0 rounded-lg border border-blue-300 bg-white px-3 py-1.5 text-xs font-bold text-blue-700 transition hover:bg-blue-100" aria-controls="originSearchPanel">Ganti</button>
          </div>
        </div>

        <!-- Origin Search (shown when no pin or changing) -->
        <div id="originSearchPanel">
          <div class="relative">
            <label for="originSearch" class="sr-only">Cari kecamatan atau kelurahan origin</label>
            <input id="originSearch" type="text" placeholder="Ketik kecamatan/kelurahan, min 3 huruf..." autocomplete="off" class="admin-input-flat h-11 text-base md:text-sm" aria-describedby="originSearchHint" aria-controls="originSearchResults" aria-expanded="false" />
          </div>
          <p id="originSearchHint" class="mt-1.5 min-h-5 text-xs font-medium text-slate-400" role="status" aria-live="polite" aria-atomic="true">Ketik minimal 3 huruf untuk mencari kecamatan di database Mengantar.</p>
          <div id="originSearchResults" class="mt-2 hidden max-h-64 divide-y divide-slate-100 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-sm" aria-label="Hasil pencarian origin"></div>
        </div>

        <!-- Hidden fields -->
        <input id="originAreaId" type="hidden" required />
        <input id="city" type="hidden" required />
        <input id="province" type="hidden" required />
      </div>

      <!-- Section 3: Alamat pickup -->
      <div class="border-b border-slate-100 p-5 md:p-6">
        <p class="mb-1 text-[10px] font-black uppercase tracking-wider text-slate-400">Detail Alamat Pickup</p>
        <p class="mb-4 text-xs leading-5 text-slate-500">AdsBookCMS menyinkronkan alamat ini ke Mengantar dan menyimpan ID provider yang valid.</p>
        <div class="grid-cols-1 grid gap-5">
          <label>
            <span class="mb-1.5 block text-xs font-black text-slate-700">Alamat jalan</span>
            <textarea id="address" required maxlength="500" rows="2" autocomplete="street-address" placeholder="Contoh: Jl. Branjangan 18A" class="admin-input-flat min-h-20 resize-y text-base md:text-sm"></textarea>
          </label>
          <label>
            <span class="mb-1.5 block text-xs font-black text-slate-700">Pickup Address ID <span class="font-medium text-slate-400">(opsional)</span></span>
            <input id="pickupAddressId" maxlength="120" autocomplete="off" placeholder="Dibuat otomatis jika kosong atau sudah tidak valid" class="admin-input-flat h-11 font-mono text-base md:text-sm" />
            <small class="mt-1 block text-xs text-slate-400">Jika ID lama sudah hilang di Mengantar, AdsBookCMS akan mencari alamat yang sama atau membuat alamat pickup baru.</small>
          </label>
        </div>
      </div>

      <!-- Save -->
      <div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
        <p id="warehouseStatus" class="min-h-5 text-xs font-bold text-slate-500" role="status" aria-live="polite" aria-atomic="true">Perubahan belum ada.</p>
        <button id="saveWarehouse" type="submit" class="btn-blue min-h-11 w-full px-6 text-xs sm:w-auto">Simpan gudang</button>
      </div>
    </form>
  </div>

  <script>
    import { groupLocationResults, type GroupableLocation, type LocationDistrictGroup } from '../../../lib/location-search';

    type OriginLocation = GroupableLocation & {
      id: string;
      label: string;
      subdistrict_name: string;
      postal_code: string;
    };
    // --- Helpers ---
    const normalizePhone = (raw: string) => {
      const digits = String(raw || '').replace(/\D/g, '');
      if (!digits) return '';
      if (digits.startsWith('620')) return `62${digits.slice(3)}`;
      if (digits.startsWith('0')) return `62${digits.slice(1)}`;
      if (digits.startsWith('8')) return `62${digits}`;
      if (digits.startsWith('62')) return digits;
      return digits;
    };

    // --- DOM refs ---
    const form = document.getElementById('warehouseForm') as HTMLFormElement | null;
    const save = document.getElementById('saveWarehouse') as HTMLButtonElement | null;
    const status = document.getElementById('warehouseStatus');
    const phoneInput = document.getElementById('contactPhone') as HTMLInputElement | null;
    const phoneHint = document.getElementById('contactPhoneHint');
    const originPinBadge = document.getElementById('originPinBadge');
    const originPinLabel = document.getElementById('originPinLabel');
    const originPinMeta = document.getElementById('originPinMeta');
    const originPinChange = document.getElementById('originPinChange') as HTMLButtonElement | null;
    const originSearchPanel = document.getElementById('originSearchPanel');
    const originSearch = document.getElementById('originSearch') as HTMLInputElement | null;
    const originSearchHint = document.getElementById('originSearchHint');
    const originSearchResults = document.getElementById('originSearchResults');
    const originAreaId = document.getElementById('originAreaId') as HTMLInputElement | null;
    const cityInput = document.getElementById('city') as HTMLInputElement | null;
    const provinceInput = document.getElementById('province') as HTMLInputElement | null;

    const loading = document.getElementById('warehouseLoading');
    let pending = false;
    const field = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;

    const show = (message: string, state: 'idle' | 'success' | 'error') => {
      if (!status) return;
      status.setAttribute('role', state === 'error' ? 'alert' : 'status');
      status.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      status.textContent = message;
      status.className = `min-h-5 text-xs font-bold ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };

    // --- Origin Pin State ---
    let currentOriginLabel = '';

    const showOriginPin = (label: string, areaId: string, city: string, province: string) => {
      currentOriginLabel = label;
      if (originPinLabel) originPinLabel.textContent = label;
      if (originPinMeta) originPinMeta.textContent = `Area ID: ${areaId} · ${city}, ${province}`;
      originPinBadge?.classList.remove('hidden');
      originSearchPanel?.classList.add('hidden');
      originSearchResults?.classList.add('hidden');
      originSearch?.setAttribute('aria-expanded', 'false');
      if (originAreaId) originAreaId.value = areaId;
      if (cityInput) cityInput.value = city;
      if (provinceInput) provinceInput.value = province;
    };

    const resetOriginPin = () => {
      areaAbort?.abort();
      areaAbort = null;
      currentOriginLabel = '';
      originPinBadge?.classList.add('hidden');
      originSearchPanel?.classList.remove('hidden');
      if (originAreaId) originAreaId.value = '';
      if (cityInput) cityInput.value = '';
      if (provinceInput) provinceInput.value = '';
      if (originSearch) { originSearch.value = ''; originSearch.setAttribute('aria-expanded', 'false'); originSearch.focus(); }
      originSearchResults?.classList.add('hidden');
      if (originSearchHint) originSearchHint.textContent = 'Ketik minimal 3 huruf untuk mencari kecamatan di database Mengantar.';
      show('Pilih origin baru, lalu simpan perubahan.', 'idle');
    };

    originPinChange?.addEventListener('click', resetOriginPin);

    // --- Phone auto-format (same pattern as checkout form) ---
    phoneInput?.addEventListener('input', () => {
      const digits = String(phoneInput.value || '').replace(/\D/g, '');
      if (!digits) { phoneInput.value = ''; return; }
      if (digits.startsWith('620')) phoneInput.value = `62${digits.slice(3)}`;
      else if (digits.startsWith('0')) phoneInput.value = `62${digits.slice(1)}`;
      else if (digits.startsWith('8')) phoneInput.value = `62${digits}`;
      else if (digits.startsWith('62')) phoneInput.value = digits;
      else phoneInput.value = digits;
      // Live hint
      if (phoneHint) {
        const v = phoneInput.value;
        if (v.length >= 10 && v.startsWith('62')) {
          phoneHint.textContent = `Format OK: ${v}`;
          phoneHint.className = 'mt-1 block text-xs text-blue-600';
        } else if (v.length > 0) {
          phoneHint.textContent = 'Nomor belum lengkap. Min 10 digit dimulai 62.';
          phoneHint.className = 'mt-1 block text-xs text-amber-600';
        } else {
          phoneHint.textContent = 'Format otomatis ke 62. Contoh: 085854117766 → 6285854117766';
          phoneHint.className = 'mt-1 block text-xs text-slate-400';
        }
      }
    });
    phoneInput?.addEventListener('blur', () => { if (phoneInput.value) phoneInput.value = normalizePhone(phoneInput.value); });

    // --- Origin Kecamatan Search ---
    let areaAbort: AbortController | null = null;
    const doOriginSearch = async () => {
      const q = (originSearch?.value || '').trim();
      areaAbort?.abort();
      areaAbort = null;
      if (q.length < 3) {
        if (originSearchHint) originSearchHint.textContent = 'Ketik minimal 3 huruf untuk mencari kecamatan di database Mengantar.';
        originSearchResults?.classList.add('hidden');
        originSearch?.setAttribute('aria-expanded', 'false');
        return;
      }
      areaAbort = new AbortController();
      if (originSearchHint) { originSearchHint.textContent = 'Mencari…'; originSearchHint.className = 'mt-1.5 min-h-5 text-xs font-medium text-slate-400'; }
      originSearchResults?.classList.add('hidden');
      originSearch?.setAttribute('aria-expanded', 'false');
      try {
        const r = await fetch(`/api/locations?search=${encodeURIComponent(q)}`, { signal: areaAbort.signal });
        const p = await r.json();
        const items: OriginLocation[] = (Array.isArray(p?.items) ? p.items : []).map((item: any) => ({
          id: String(item.id || item.location_id || ''),
          label: String(item.label || ''),
          district: String(item.district_name || item.district || item.subdistrict_name || ''),
          district_name: String(item.district_name || item.district || ''),
          subdistrict_name: String(item.subdistrict_name || ''),
          city: String(item.city_name || item.city || ''),
          province: String(item.province_name || item.province || ''),
          postal_code: String(item.postal_code || '-'),
        }));
        if (!items.length) {
          if (originSearchHint) originSearchHint.textContent = 'Tidak ditemukan. Coba kata kunci lain (contoh: "krembangan selatan").';
          originSearch?.setAttribute('aria-expanded', 'false');
          return;
        }

        const groups = groupLocationResults(items);
        const selectOrigin = (item: OriginLocation) => {
          showOriginPin(item.label, item.id, item.city, item.province);
          show('Pin origin diperbarui. Jangan lupa simpan.', 'idle');
        };
        const createOriginRow = (title: string, detail: string, onClick: () => void) => {
          const row = document.createElement('button');
          row.type = 'button';
          row.className = 'group flex w-full items-center gap-3 px-4 py-3 text-left transition hover:bg-blue-50';
          row.innerHTML = `
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-400 transition group-hover:bg-blue-200 group-hover:text-blue-700">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" /></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold text-slate-900">${title}</p>
              <p class="mt-0.5 text-[11px] text-slate-400">${detail}</p>
            </div>`;
          row.addEventListener('click', onClick);
          return row;
        };
        function renderOriginDistricts() {
          if (!originSearchResults) return;
          originSearchResults.innerHTML = '';
          if (originSearchHint) {
            originSearchHint.textContent = `${groups.length} kecamatan ditemukan. Pilih kecamatan lokasi gudang.`;
            originSearchHint.className = 'mt-1.5 min-h-5 text-xs font-medium text-blue-600';
          }
          groups.forEach((group) => {
            originSearchResults.appendChild(createOriginRow(
              group.district,
              `${group.city}, ${group.province}${group.items.length > 1 ? ` · ${group.items.length} kelurahan/desa` : ''}`,
              () => {
                if (group.items.length > 1 && group.items.some((item) => item.subdistrict_name)) {
                  renderOriginSubdistricts(group);
                  return;
                }
                selectOrigin(group.items[0]);
              },
            ));
          });
          originSearchResults.classList.remove('hidden');
          originSearch?.setAttribute('aria-expanded', 'true');
        }
        function renderOriginSubdistricts(group: LocationDistrictGroup<OriginLocation>) {
          if (!originSearchResults) return;
          originSearchResults.innerHTML = '';
          if (originSearchHint) {
            originSearchHint.textContent = `Pilih kelurahan/desa di Kecamatan ${group.district}.`;
            originSearchHint.className = 'mt-1.5 min-h-5 text-xs font-medium text-slate-600';
          }
          originSearchResults.appendChild(createOriginRow(
            '← Pilih kecamatan lain',
            `${group.district}, ${group.city}, ${group.province}`,
            renderOriginDistricts,
          ));
          group.items.forEach((item) => {
            originSearchResults.appendChild(createOriginRow(
              item.subdistrict_name || group.district,
              `Kecamatan ${group.district} · Kode Pos ${item.postal_code}`,
              () => selectOrigin(item),
            ));
          });
        }
        renderOriginDistricts();
      } catch (e: any) {
        if (e?.name === 'AbortError') return;
        originSearch?.setAttribute('aria-expanded', 'false');
        if (originSearchHint) { originSearchHint.textContent = 'Gagal mencari. Coba lagi.'; originSearchHint.className = 'mt-1.5 min-h-5 text-xs font-medium text-rose-600'; }
      }
    };

    originSearch?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doOriginSearch(); } });
    let originDebounce: ReturnType<typeof setTimeout>;
    originSearch?.addEventListener('input', () => { clearTimeout(originDebounce); originDebounce = setTimeout(doOriginSearch, 400); });

    // --- Load existing data ---
    fetch('/api/admin/settings', { headers: { Accept: 'application/json' } }).then(async r => {
      const p = await r.json().catch(() => ({}));
      if (!r.ok || !p.success) throw new Error(p.error || 'Gagal memuat gudang.');
      return p.data.warehouse;
    }).then(data => {
      field('warehouseName')!.value = data.name || '';
      field('contactName')!.value = data.contact_name || '';
      field('contactPhone')!.value = normalizePhone(data.contact_phone || '');
      field('pickupAddressId')!.value = data.pickup_address_id || '';
      field('address')!.value = data.address || '';
      phoneInput?.dispatchEvent(new Event('input'));

      const areaId = data.origin_area_id || '';
      const city = data.city || '';
      const province = data.province || '';
      const storedOriginLabel = data.origin_label || '';
      if (areaId) {
        const pinLabel = storedOriginLabel || [city, province].filter(Boolean).join(', ') || 'Origin tersimpan';
        showOriginPin(pinLabel, areaId, city, province);
      }

      loading?.setAttribute('aria-busy', 'false');
      loading?.classList.add('hidden');
      form?.classList.remove('hidden');
    }).catch(error => {
      loading?.setAttribute('aria-busy', 'false');
      loading?.classList.add('hidden');
      const box = document.getElementById('warehouseError');
      if (box) { box.textContent = error instanceof Error ? error.message : 'Gagal memuat gudang.'; box.classList.remove('hidden'); }
    });

    // --- Save ---
    form?.addEventListener('submit', async event => {
      event.preventDefault();
      if (pending) return;
      if (!originAreaId?.value) {
        show('Pilih kecamatan origin dulu.', 'error');
        originSearch?.focus();
        return;
      }
      if (!form.reportValidity()) return;
      pending = true;
      if (save) {
        save.disabled = true;
        save.textContent = 'Menyimpan…';
      }
      form.setAttribute('aria-busy', 'true');
      show('Menyimpan konfigurasi gudang…', 'idle');
      const warehouse = {
        name: field('warehouseName')?.value,
        contact_name: field('contactName')?.value,
        contact_phone: normalizePhone(field('contactPhone')?.value || ''),
        origin_area_id: originAreaId?.value,
        origin_label: currentOriginLabel,
        pickup_address_id: field('pickupAddressId')?.value,
        address: field('address')?.value,
        city: cityInput?.value,
        province: provinceInput?.value,
      };
      try {
        const r = await fetch('/api/admin/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'save-warehouse', warehouse }) });
        const p = await r.json().catch(() => ({}));
        if (!r.ok || !p.success) throw new Error(p.error || 'Gagal menyimpan gudang.');
        if (p.data?.pickup_address_id) field('pickupAddressId')!.value = p.data.pickup_address_id;
        show(p.message || 'Konfigurasi gudang tersimpan.', 'success');
      } catch (error) {
        show(error instanceof Error ? error.message : 'Gagal menyimpan gudang.', 'error');
      } finally {
        pending = false;
        if (save) {
          save.disabled = false;
          save.textContent = 'Simpan gudang';
        }
        form.setAttribute('aria-busy', 'false');
      }
    });
  </script>
</AdminLayout>
