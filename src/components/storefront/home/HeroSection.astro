---

interface Slide {
  image: string;
  alt: string;
  badge: string;
  text: string;
}

interface Highlight {
  label: string;
  icon: string;
}
interface HeroContent {
  title: string;
  description: string;
  ratingLabel: string;
}

interface Props {
  slides: Slide[];
  highlights: Highlight[];
  content: HeroContent;
}

const { slides } = Astro.props;
---

<section class="border-b border-[#E5E5E5] bg-white">
  <h1 class="sr-only">{Astro.locals.tenant.name} — {Astro.locals.tenant.tagline}</h1>
  <div class="relative overflow-hidden border-t border-[#E5E5E5] bg-white">
    <div id="hero-track" class="flex transition-transform duration-700 ease-out will-change-transform">
      {
        slides.map((slide, index) => (
          <article class="relative min-w-full">
            <img
              src={slide.image}
              alt={`${slide.alt} - ${Astro.locals.tenant.name}`}
              title={slide.badge}
              width="600"
              height="600"
              class="aspect-square w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding={index === 0 ? 'sync' : 'async'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#111111]/85 via-[#111111]/10 to-transparent" />
            <div class="absolute inset-x-0 bottom-0 p-5 pb-14 text-white">
              <span class="inline-flex rounded-sm bg-[#111111] px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.15em] text-white">
                {slide.badge}
              </span>
              <p class="mt-3 max-w-[24rem] text-[13px] font-normal leading-5 text-white">
                {slide.text}
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <div id="hero-dots" class="absolute bottom-2 left-5 z-10 flex items-end gap-2">
      {
        slides.map((_, index) => (
          <button
            type="button"
            aria-label={`Tampilkan slide ${index + 1}`}
            class={index === 0
              ? 'h-11 w-7 border-b-2 border-white bg-transparent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'
              : 'h-11 w-4 border-b border-white/55 bg-transparent transition-colors hover:border-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'}
          />
        ))
      }
    </div>
  </div>
</section>
