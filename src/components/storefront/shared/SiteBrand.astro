---
interface Props {
  href?: string;
  class?: string;
}

const { href = '/', class: className = '' } = Astro.props;
// Always the tenant's own name. The wordmark once spelled out the reference
// store's name on every install (LOGIN-10/18); it reads the tenant or nothing.
// Set in the body face, not a display serif: a default storefront has to suit
// a kitchenware shop as well as a perfume one.
const storeName = Astro.locals.tenant.name.trim();
const monogram = (storeName[0] ?? 'A').toUpperCase();
const brandMark = Astro.locals.tenant.brandMark;
---

<a
  href={href}
  class={`inline-flex min-h-11 min-w-0 items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111] ${className}`}
  aria-label={Astro.locals.tenant.name}
  title={Astro.locals.tenant.defaultTitle}
>
  <!-- The letter is drawn by CSS rather than written as a text node. As markup
       it was a second visible string inside the link that the accessible name
       did not contain, which is `label-content-name-mismatch` (WCAG 2.5.3) —
       `aria-hidden` keeps it out of the accessible name but not out of what an
       auditor reads as the link's visible text. Generated content is not text
       either way, and a decorative duplicate of a letter that is already
       spelled out beside it should never have been a text node.
       A store that sets PUBLIC_SITE_BRAND_MARK shows its own mark instead,
       decorative for the same reason (empty alt). Sized by the width
       attribute, not h-7: that utility resolves through var(--spacing), which
       a page's inlined CSS can leave undefined, and the image then renders at
       its intrinsic size. -->
  {
    brandMark ? (
      <img
        src={brandMark}
        alt=""
        width="32"
        height="32"
        class="shrink-0 object-contain"
        decoding="async"
      />
    ) : (
      <span
        aria-hidden="true"
        data-monogram={monogram}
        class="site-brand-monogram flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#111111] text-sm font-bold text-white"
      ></span>
    )
  }

  <span class="min-w-0 truncate text-[17px] font-bold leading-none tracking-[-0.01em] text-[#111111]">{storeName}</span>
</a>

<style>
  .site-brand-monogram::before {
    content: attr(data-monogram);
  }
</style>
