---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormHybridContent from '../components/forms/FormHybridContent.astro';
import FormMiddleContent from '../components/forms/FormMiddleContent.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { getRuntimeEnv } from '../lib/env';
import { resolveFormVariant } from '../lib/form-config';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const productKey = Astro.url.searchParams.get('product_id')?.trim();
if (!productKey) return Astro.redirect('/produk');
const variantKey = Astro.url.searchParams.get('variant_id')?.trim() || Astro.url.searchParams.get('variant')?.trim();
const product = await getStorefrontProduct(Astro.locals, productKey);
if (!product) return Astro.redirect('/produk');
const selectedVariant = resolveFormVariant(product, variantKey);
if (!selectedVariant) return Astro.redirect(`/produk/${product.slug}`);
const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes =
  await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);
---

<BaseLayout
  title={`Form Pemesanan ${product.productName} - ${Astro.locals.tenant.name}`}
  description={`Form pemesanan adaptif ${product.productName} dengan mode middle atau full berdasarkan wilayah pengunjung.`}
  image={product.heroImage}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug="hybrid-form"
    productId={product.productId}
    contentName={product.productName}
    price={selectedVariant.price}
  />
  <div class="mx-auto max-w-[480px] bg-white py-4">
    {
      formContext.resolvedMode === 'middle' ? (
        <FormMiddleContent
          productSlug={product.slug}
          selectedVariantId={selectedVariant.id}
          province={formContext.province}
          codDisabledProvinceCodes={codDisabledProvinceCodes}
          embedded={true}
        />
      ) : (
        <FormHybridContent
          productSlug={product.slug}
          selectedVariantId={selectedVariant.id}
          codDisabledProvinceCodes={codDisabledProvinceCodes}
          embedded={true}
        />
      )
    }
  </div>
</BaseLayout>
