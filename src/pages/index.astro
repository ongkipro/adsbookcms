---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactMarketHome from '../components/storefront/templates/CompactMarketHome.astro';
import WideCatalogHome from '../components/storefront/templates/WideCatalogHome.astro';
import { getStorefrontProducts } from '../lib/catalog';
import { getTenantHomeContent } from '../lib/tenant-content';

const [catalog, content] = await Promise.all([
  getStorefrontProducts(Astro.locals),
  getTenantHomeContent(Astro.locals),
]);
const products = catalog.map((product) => ({
  name: product.productName,
  category: product.category,
  description: product.subheadline || product.description,
  href: `/produk/${product.slug}`,
  image: product.image,
  price: product.price,
  comparePrice: product.comparePrice,
  ratingValue: product.ratingValue,
  reviewCount: product.reviewCount,
  soldCount: product.soldCount,
  variants: product.variants.map((variant) => ({
    label: variant.label,
    price: variant.price,
  })),
}));
const isWide = Astro.locals.tenant.storefrontTemplate === 'wide-catalog';
const homepageTitle = `${Astro.locals.tenant.name} — ${Astro.locals.tenant.tagline || Astro.locals.tenant.description}`;
const itemList = {
  name: `${Astro.locals.tenant.name} — Koleksi Produk pilihan`,
  items: products.map((p) => ({
    name: p.name,
    url: p.href,
    image: p.image,
    price: p.price,
    description: p.description,
  })),
};
---

<BaseLayout
  title={homepageTitle}
  description={Astro.locals.tenant.description}
  image={content?.heroSlides[0]?.image ?? Astro.locals.tenant.logo}
  hideHeader={isWide}
  hideFooter={isWide}
  contentWidth={isWide ? 'wide' : 'compact'}
  itemList={itemList}
>
  {
    !content ? (
      <section class="mx-auto flex min-h-[70vh] max-w-2xl items-center px-6 py-20 text-center">
        <div class="w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-sm md:p-12">
          <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-700">Storefront Setup</p>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-950">{Astro.locals.tenant.name}</h1>
          <p class="mx-auto mt-4 max-w-lg text-sm leading-7 text-slate-600">
            Storefront sedang disiapkan. Owner perlu menerbitkan konten dari CMS sebelum halaman ini dapat ditampilkan.
          </p>
        </div>
      </section>
    ) : isWide ? (
      <WideCatalogHome
        content={content}
        products={products}
        tenantName={Astro.locals.tenant.name}
        logo={Astro.locals.tenant.logo}
        accent={Astro.locals.tenant.themeColor}
      />
    ) : (
      <CompactMarketHome content={content} products={products} />
    )
  }
</BaseLayout>
