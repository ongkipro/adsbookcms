---
import { ProductForm } from '../../../components/admin/ProductForm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
export const prerender = false;
---

<AdminLayout title="Tambah Produk" activeMenu="products">
  <div class="mx-auto max-w-7xl space-y-5">
    <AdminPageHeader
      eyebrow="Catalog"
      title="Tambah produk"
      description="Simpan identitas produk, storefront, SKU, harga, berat, dan stok dalam satu operasi."
      backHref="/admin/products"
      backLabel="Katalog produk"
    />
    <ProductForm client:load />
  </div>
</AdminLayout>
