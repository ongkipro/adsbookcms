---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
export const prerender = false;
---

<AdminLayout title="Pengaturan" activeMenu="settings">
  <div class="space-y-6">
    <AdminPageHeader
      eyebrow="Workspace"
      title="Pengaturan sistem"
      description="Status integrasi, profil store, gudang, template CRM, dan akses pengguna."
    />
    <div id="settingsLoading" class="grid grid-cols-1 gap-4 lg:grid-cols-2" role="status" aria-live="polite" aria-busy="true" aria-atomic="true"><span class="sr-only">Memuat status integrasi.</span><div class="h-52 animate-pulse rounded-xl bg-slate-100"></div><div class="h-52 animate-pulse rounded-xl bg-slate-100"></div></div>
    <div id="settingsError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-800" role="alert" aria-live="assertive"></div>
    <section id="credentialCards" class="hidden grid grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Status integrasi">
      <article class="rounded-xl border border-slate-200 bg-white text-slate-950 shadow-sm p-6"><div class="flex items-start justify-between gap-3"><div><h3 class="font-black text-slate-950">Mengantar API</h3><p class="mt-1 text-xs text-slate-500">Tarif, shipment, pickup, tracking, dan COD.</p></div><span id="mengantarBadge" class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-black text-slate-600">Memuat</span></div><dl class="mt-5 grid grid-cols-1 gap-3 text-xs sm:grid-cols-2"><div class="min-w-0 rounded-xl bg-slate-50 p-3"><dt class="font-bold text-slate-500">API key</dt><dd id="mengantarKey" class="mt-1 truncate font-mono text-slate-800">Disembunyikan</dd></div><div class="min-w-0 rounded-xl bg-slate-50 p-3"><dt class="font-bold text-slate-500">Base URL</dt><dd id="mengantarUrl" class="mt-1 truncate font-mono text-slate-800">-</dd></div></dl><div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center"><button id="testMengantar" type="button" class="btn-secondary min-h-11 w-full px-4 text-xs sm:w-auto" aria-controls="mengantarStatus">Tes koneksi</button><p id="mengantarStatus" class="min-h-5 text-xs font-bold text-slate-500" role="status" aria-live="polite" aria-atomic="true">Siap dites.</p></div></article>
      <article class="rounded-xl border border-slate-200 bg-white text-slate-950 shadow-sm p-6"><div class="flex items-start justify-between gap-3"><div><h3 class="font-black text-slate-950">AutoLaris</h3><p class="mt-1 text-xs text-slate-500">Payment gateway VA, QRIS, DANA, dan callback.</p></div><span id="autolarisBadge" class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-black text-slate-600">Memuat</span></div><dl class="mt-5 grid grid-cols-1 gap-3 text-xs sm:grid-cols-2"><div class="min-w-0 rounded-xl bg-slate-50 p-3"><dt class="font-bold text-slate-500">API key</dt><dd id="autolarisKey" class="mt-1 truncate font-mono text-slate-800">Disembunyikan</dd></div><div class="min-w-0 rounded-xl bg-slate-50 p-3"><dt class="font-bold text-slate-500">Custom callback secret</dt><dd id="autolarisWebhook" class="mt-1 truncate font-mono text-slate-800">Disembunyikan</dd></div></dl><div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center"><button id="testAutolaris" type="button" class="btn-secondary min-h-11 w-full px-4 text-xs sm:w-auto" aria-controls="autolarisStatus">Periksa konfigurasi</button><p id="autolarisStatus" class="min-h-5 text-xs font-bold text-slate-500" role="status" aria-live="polite" aria-atomic="true">Tidak membuat transaksi provider.</p></div></article>
    </section>
    <section class="grid grid-cols-1 gap-3 sm:grid-cols-3" aria-label="Halaman pengaturan"><a href="/admin/settings/store" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-blue-300"><p class="font-black text-slate-950">Store & CS</p><p class="mt-1 text-xs leading-5 text-slate-500">Identitas merchant dan WhatsApp.</p></a><a href="/admin/settings/warehouse" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-blue-300"><p class="font-black text-slate-950">Gudang</p><p class="mt-1 text-xs leading-5 text-slate-500">Origin, pickup ID, dan PIC.</p></a><a href="/admin/settings/crm" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-blue-300"><p class="font-black text-slate-950">CRM Templates</p><p class="mt-1 text-xs leading-5 text-slate-500">Welcome dan follow-up 1–7.</p></a></section>
  </div>
  <script>
    const text = (id: string, value: string) => { const node = document.getElementById(id); if (node) node.textContent = value; };
    const setStatus = (id: string, message: string, state: 'idle' | 'success' | 'error') => { const node = document.getElementById(id); if (!node) return; node.setAttribute('role', state === 'error' ? 'alert' : 'status'); node.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite'); node.textContent = message; node.className = `min-h-5 text-xs font-bold ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`; };
    const badge = (id: string, ready: boolean, partial = false) => { const node = document.getElementById(id); if (!node) return; node.textContent = ready ? 'Aktif' : partial ? 'Belum lengkap' : 'Belum dikonfigurasi'; node.className = ready ? 'rounded-full bg-blue-100 px-2.5 py-1 text-[10px] font-black text-blue-800' : partial ? 'rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-black text-amber-800' : 'rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-black text-slate-600'; };
    const loading = document.getElementById('settingsLoading');
    fetch('/api/admin/settings', { headers: { Accept: 'application/json' } }).then(async (response) => { const payload = await response.json().catch(() => ({})); if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat pengaturan.'); return payload.data.credentials; }).then((data) => { badge('mengantarBadge', data.mengantar.configured); badge('autolarisBadge', data.autolaris.configured, data.autolaris.api_key_configured || data.autolaris.webhook_secret_configured); text('mengantarKey', data.mengantar.api_key_masked || 'Belum dikonfigurasi'); text('mengantarUrl', data.mengantar.base_url); text('autolarisKey', data.autolaris.api_key_masked || 'Belum dikonfigurasi'); text('autolarisWebhook', data.autolaris.webhook_secret_masked || 'Belum dikonfigurasi'); loading?.setAttribute('aria-busy', 'false'); loading?.classList.add('hidden'); document.getElementById('credentialCards')?.classList.remove('hidden'); }).catch((error) => { loading?.setAttribute('aria-busy', 'false'); loading?.classList.add('hidden'); const box = document.getElementById('settingsError'); if (box) { box.textContent = error instanceof Error ? error.message : 'Gagal memuat pengaturan.'; box.classList.remove('hidden'); } });
    const run = async (action: string, buttonId: string, statusId: string) => {
      const button = document.getElementById(buttonId) as HTMLButtonElement | null;
      if (!button || button.disabled) return;
      const label = button.textContent || 'Periksa konfigurasi';
      button.disabled = true;
      button.textContent = 'Memeriksa…';
      button.setAttribute('aria-busy', 'true');
      setStatus(statusId, 'Memeriksa konfigurasi…', 'idle');
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) {
          throw new Error(payload.message || payload.error || 'Pemeriksaan gagal.');
        }
        setStatus(statusId, payload.message || 'Konfigurasi tersedia.', 'success');
      } catch (error) {
        setStatus(
          statusId,
          error instanceof Error ? error.message : 'Pemeriksaan gagal.',
          'error',
        );
      } finally {
        button.disabled = false;
        button.textContent = label;
        button.setAttribute('aria-busy', 'false');
      }
    };
    document.getElementById('testMengantar')?.addEventListener('click', () => run('test-mengantar', 'testMengantar', 'mengantarStatus'));
    document.getElementById('testAutolaris')?.addEventListener('click', () => run('test-autolaris', 'testAutolaris', 'autolarisStatus'));
  </script>
</AdminLayout>
