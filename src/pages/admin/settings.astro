---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import { buttonVariants } from '../../components/ui/button';
export const prerender = false;
const mayManageAccess = Astro.locals.admin?.role === 'owner';
const outline = buttonVariants({ variant: 'outline' });
const links = [
  { href: '/admin/settings/store', title: 'Toko & customer service', detail: 'Identitas toko, alamat storefront, dan WhatsApp CS.' },
  { href: '/admin/settings/warehouse', title: 'Gudang & pickup', detail: 'Origin pengiriman, alamat pickup, dan PIC.' },
  { href: '/admin/settings/crm', title: 'Template CRM', detail: 'Pesan welcome dan follow-up WhatsApp.' },
  { href: '/admin/settings/developer', title: 'Headless API & domain', detail: 'API key dan domain yang boleh memanggil API.' },
  ...(mayManageAccess ? [{ href: '/admin/settings/access', title: 'Akses pengguna', detail: 'Akun operator dan perannya.' }] : []),
];
---

<AdminLayout title="Pengaturan" activeMenu="settings">
  <div class="space-y-6">
    <AdminPageHeader
      title="Pengaturan sistem"
      description="Status integrasi dan semua halaman pengaturan toko."
    />

    <section class="rounded-xl border bg-white" aria-labelledby="integrations-heading">
      <h3 id="integrations-heading" class="border-b px-4 py-3 text-sm font-semibold text-slate-950">Integrasi</h3>
      <div id="settingsLoading" class="p-4 text-sm text-slate-500" role="status" aria-live="polite" aria-busy="true">Memuat status integrasi…</div>
      <div id="settingsError" class="hidden p-4 text-sm font-medium text-rose-700" role="alert"></div>
      <div id="credentialCards" class="hidden divide-y">
        <div class="flex flex-col gap-3 px-4 py-3 lg:flex-row lg:items-center">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-slate-950">Mengantar</p>
            <p class="text-xs text-slate-500">Ongkir, COD, resi, pickup, dan tracking · key <span id="mengantarKey" class="font-mono">disembunyikan</span> · <span id="mengantarUrl" class="font-mono"></span></p>
            <p id="mengantarStatus" class="mt-1 min-h-4 text-xs text-slate-500" role="status" aria-live="polite"></p>
          </div>
          <span id="mengantarBadge" class="w-fit rounded-md border px-2 py-0.5 text-xs font-medium">Memuat</span>
          <button id="testMengantar" type="button" class={outline}>Tes koneksi</button>
        </div>
        <div class="flex flex-col gap-3 px-4 py-3 lg:flex-row lg:items-center">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-slate-950">AutoLaris</p>
            <p class="text-xs text-slate-500">QRIS dan Virtual Account, dicek otomatis setiap jam; yang belum terbaca bisa dikonfirmasi manual · key <span id="autolarisKey" class="font-mono">disembunyikan</span></p>
            <p id="autolarisStatus" class="mt-1 min-h-4 text-xs text-slate-500" role="status" aria-live="polite"></p>
          </div>
          <span id="autolarisBadge" class="w-fit rounded-md border px-2 py-0.5 text-xs font-medium">Memuat</span>
          <div class="flex gap-2">
            <button id="testAutolaris" type="button" class={outline}>Periksa konfigurasi</button>
            <a href="/admin/balance" class={outline}>Rekonsiliasi</a>
          </div>
        </div>
      </div>
    </section>

    <nav class="rounded-xl border bg-white" aria-label="Halaman pengaturan">
      <ul class="divide-y">
        {links.map((link) => (
          <li>
            <a href={link.href} class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50">
              <span class="min-w-0 flex-1">
                <span class="block font-medium text-slate-950">{link.title}</span>
                <span class="block text-xs text-slate-500">{link.detail}</span>
              </span>
              <span class="text-slate-400" aria-hidden="true">›</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <script>
    const text = (id: string, value: string) => {
      const node = document.getElementById(id);
      if (node) node.textContent = value;
    };
    const setStatus = (id: string, message: string, state: 'idle' | 'success' | 'error') => {
      const node = document.getElementById(id);
      if (!node) return;
      node.setAttribute('role', state === 'error' ? 'alert' : 'status');
      node.textContent = message;
      node.className = `mt-1 min-h-4 text-xs ${state === 'success' ? 'text-emerald-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };
    const badge = (id: string, ready: boolean, label?: string) => {
      const node = document.getElementById(id);
      if (!node) return;
      node.textContent = label ?? (ready ? 'Aktif' : 'Belum dikonfigurasi');
      node.className = `w-fit rounded-md border px-2 py-0.5 text-xs font-medium ${ready ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-slate-200 bg-slate-50 text-slate-600'}`;
    };
    const loading = document.getElementById('settingsLoading');
    fetch('/api/admin/settings', { headers: { Accept: 'application/json' } })
      .then(async (response) => {
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat pengaturan.');
        return payload.data.credentials;
      })
      .then((data) => {
        badge('mengantarBadge', Boolean(data.mengantar.configured));
        const autolarisConfigured = Boolean(data.autolaris.api_key_configured);
        badge('autolarisBadge', autolarisConfigured, autolarisConfigured ? 'API key tersimpan' : 'API key belum diatur');
        text('mengantarKey', data.mengantar.api_key_masked || 'belum diatur');
        text('mengantarUrl', data.mengantar.base_url || '');
        text('autolarisKey', data.autolaris.api_key_masked || 'belum diatur');
        loading?.setAttribute('aria-busy', 'false');
        loading?.classList.add('hidden');
        document.getElementById('credentialCards')?.classList.remove('hidden');
      })
      .catch((error) => {
        loading?.setAttribute('aria-busy', 'false');
        loading?.classList.add('hidden');
        const box = document.getElementById('settingsError');
        if (box) {
          box.textContent = error instanceof Error ? error.message : 'Gagal memuat pengaturan.';
          box.classList.remove('hidden');
        }
      });
    const run = async (action: string, buttonId: string, statusId: string) => {
      const button = document.getElementById(buttonId) as HTMLButtonElement | null;
      if (!button || button.disabled) return;
      const label = button.textContent || 'Periksa konfigurasi';
      button.disabled = true;
      button.textContent = 'Memeriksa…';
      button.setAttribute('aria-busy', 'true');
      setStatus(statusId, 'Memeriksa konfigurasi…', 'idle');
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.message || payload.error || 'Pemeriksaan gagal.');
        setStatus(
          statusId,
          payload.message || 'Konfigurasi tersedia.',
          payload.verification_supported === false ? 'idle' : payload.verified ? 'success' : 'error',
        );
      } catch (error) {
        setStatus(statusId, error instanceof Error ? error.message : 'Pemeriksaan gagal.', 'error');
      } finally {
        button.disabled = false;
        button.textContent = label;
        button.setAttribute('aria-busy', 'false');
      }
    };
    document.getElementById('testMengantar')?.addEventListener('click', () => run('test-mengantar', 'testMengantar', 'mengantarStatus'));
    document.getElementById('testAutolaris')?.addEventListener('click', () => run('test-autolaris', 'testAutolaris', 'autolarisStatus'));
  </script>
</AdminLayout>
