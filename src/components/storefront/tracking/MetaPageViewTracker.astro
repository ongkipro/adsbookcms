<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;

    const createEventId = (prefix) => `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    const postMeta = (payload) => {
      fetch('/api/meta-event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).catch(() => {});
    };

    const pathname = window.location.pathname || '/';
    const contentName = document.title || pathname;
    const eventId = window.__META_PAGEVIEW_EVENT_ID__ || createEventId('pv');
    postMeta({
      event_name: 'PageView',
      event_id: eventId,
      lp_name: pathname,
      content_name: contentName,
      value: 1,
      currency: 'IDR',
      content_type: 'page',
      event_source_url: window.location.href,
    });
    // A page view is not an ecommerce event: no `ecommerce` object, so a GA4
    // tag cannot read the path as an item or the placeholder 1 as revenue.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'page_view',
      tracking_owner: 'app',
      meta_managed_by_app: true,
      meta_event_id: eventId,
    });
  })();
</script>
